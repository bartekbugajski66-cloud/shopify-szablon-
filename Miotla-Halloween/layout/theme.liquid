<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}
  {{ 'dripon.css' | asset_url | stylesheet_tag }}
  {{ 'pf.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  {% section 'pf-ticker' %}
  {% section 'pf-header' %}
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
  {% section 'pf-footer' %}
  {% render 'pf-cart' %}
  {% render 'pf-search' %}
</body>
</html>
