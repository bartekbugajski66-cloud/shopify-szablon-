{%- comment -%} Miotła Halloween — wideo-opinie (slider) · wideo z panelu (plik) lub link YouTube/Vimeo grający na stronie {%- endcomment -%}
<section class="drip-vid drip-sec drip-sec--bg" id="drip-vid-{{ section.id }}">
  <div class="drip-container drip-center">
    {%- if section.settings.eyebrow != blank -%}<span class="drip-eyebrow drip-eyebrow--amber">▶ {{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="drip-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="drip-lead">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="drip-container drip-vid__wrap">
    <button class="drip-arrow drip-arrow--prev" type="button" data-dir="-1" aria-label="Poprzednie">‹</button>
    <div class="drip-vid__track" id="drip-vid-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.video_file != blank -%}
          <div class="drip-vid__tile" {{ block.shopify_attributes }}>
            {{ block.settings.video_file | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '700x', class: 'drip-vid__video' }}
          </div>
        {%- elsif block.settings.link != blank -%}
          <div class="drip-vid__tile drip-vid__tile--link" data-link="{{ block.settings.link | escape }}" role="button" tabindex="0" aria-label="Odtwórz wideo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width:700 | image_tag: loading:'lazy', class:'drip-vid__img', alt: block.settings.alt | escape }}
            {%- else -%}<span class="drip-vid__ph"></span>{%- endif -%}
            <span class="drip-vid__play" aria-hidden="true">▶</span>
          </div>
        {%- else -%}
          <div class="drip-vid__tile" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width:700 | image_tag: loading:'lazy', class:'drip-vid__img', alt: block.settings.alt | escape }}
            {%- else -%}<span class="drip-vid__ph"></span>{%- endif -%}
            <span class="drip-vid__play" aria-hidden="true">▶</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <button class="drip-arrow drip-arrow--next" type="button" data-dir="1" aria-label="Następne">›</button>
  </div>
</section>
{%- style -%}
  #drip-vid-{{ section.id }} .drip-vid__wrap{position:relative;margin-top:8px}
  #drip-vid-{{ section.id }} .drip-vid__track{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:4px 0}
  #drip-vid-{{ section.id }} .drip-vid__track::-webkit-scrollbar{display:none}
  #drip-vid-{{ section.id }} .drip-vid__tile{position:relative;flex:0 0 78%;scroll-snap-align:center;border-radius:16px;overflow:hidden;aspect-ratio:3/4;background:#0f172a}
  #drip-vid-{{ section.id }} .drip-vid__tile--link{cursor:pointer}
  #drip-vid-{{ section.id }} .drip-vid__img{width:100%;height:100%;object-fit:cover}
  #drip-vid-{{ section.id }} .drip-vid__video{width:100%;height:100%;object-fit:cover;display:block;background:#0f172a}
  #drip-vid-{{ section.id }} .drip-vid__iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  #drip-vid-{{ section.id }} .drip-vid__ph{position:absolute;inset:0;background:linear-gradient(135deg,#1f2d44,#2b3c5c)}
  #drip-vid-{{ section.id }} .drip-vid__play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:54px;height:54px;border-radius:50%;background:rgba(255,255,255,.92);color:var(--drip-blue);display:grid;place-items:center;font-size:18px;box-shadow:0 6px 18px rgba(0,0,0,.25)}
  #drip-vid-{{ section.id }} .drip-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:42px;height:42px;border-radius:50%;border:0;background:#fff;color:var(--drip-navy);font-size:24px;line-height:1;cursor:pointer;box-shadow:0 4px 14px rgba(15,23,42,.18);display:grid;place-items:center}
  #drip-vid-{{ section.id }} .drip-arrow--prev{left:-6px}
  #drip-vid-{{ section.id }} .drip-arrow--next{right:-6px}
  @media(min-width:750px){
    #drip-vid-{{ section.id }} .drip-vid__tile{flex-basis:calc((100% - 28px)/3)}
    #drip-vid-{{ section.id }} .drip-arrow{display:grid;place-items:center}
  }
{%- endstyle -%}
<script>
(function(){
  var t=document.getElementById('drip-vid-track-{{ section.id }}');if(!t)return;
  document.querySelectorAll('#drip-vid-{{ section.id }} .drip-arrow').forEach(function(b){
    b.addEventListener('click',function(){t.scrollBy({left:t.clientWidth*0.8*parseInt(b.getAttribute('data-dir'),10),behavior:'smooth'})});
  });
  function ytId(u){var m=u.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/))([\w-]{11})/);return m?m[1]:null;}
  function vimeoId(u){var m=u.match(/vimeo\.com\/(?:video\/)?(\d+)/);return m?m[1]:null;}
  document.querySelectorAll('#drip-vid-{{ section.id }} .drip-vid__tile--link').forEach(function(tile){
    function play(){
      var u=tile.getAttribute('data-link')||'';var y=ytId(u),v=vimeoId(u),src=null;
      if(y)src='https://www.youtube.com/embed/'+y+'?autoplay=1&rel=0&modestbranding=1';
      else if(v)src='https://player.vimeo.com/video/'+v+'?autoplay=1';
      if(src){var f=document.createElement('iframe');f.src=src;f.className='drip-vid__iframe';f.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';f.setAttribute('allowfullscreen','');tile.innerHTML='';tile.appendChild(f);}
      else{window.open(u,'_blank','noopener');}
    }
    tile.addEventListener('click',play);
    tile.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();play();}});
  });
})();
</script>
{% schema %}
{
  "name": "Miotła Halloween • Wideo",
  "settings": [
    { "type":"text","id":"eyebrow","label":"Nadtytuł","default":"ZOBACZ EFEKT" },
    { "type":"text","id":"heading","label":"Nagłówek","default":"Zobacz Miotłę Halloween w akcji" },
    { "type":"textarea","id":"subheading","label":"Podnagłówek","default":"Zobacz jak świeci, porusza się i straszy gości — prawdziwe nagrania klientów." }
  ],
  "blocks": [ { "type":"video","name":"Wideo","settings":[
    {"type":"video","id":"video_file","label":"Wideo — wgraj / wybierz z panelu","info":"Odtwarza się bezpośrednio na stronie. Alternatywnie użyj linku poniżej."},
    {"type":"image_picker","id":"image","label":"Miniatura (plakat dla linku)"},
    {"type":"url","id":"link","label":"Lub wklej link (YouTube / Vimeo)","info":"Gra na stronie po kliknięciu. Inny link otworzy się w nowej karcie."},
    {"type":"text","id":"alt","label":"Opis (alt)","default":"Opinia klienta Miotła Halloween"}
  ] } ],
  "max_blocks": 10,
  "presets": [ { "name":"Miotła Halloween • Wideo", "blocks":[ {"type":"video"},{"type":"video"},{"type":"video"} ] } ]
}
{% endschema %}
