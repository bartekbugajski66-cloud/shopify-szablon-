{%- comment -%} Miotła Halloween — Technologie (styl THEVIREA) {%- endcomment -%}
<section class="drip-tech drip-sec drip-sec--bg" id="drip-tech-{{ section.id }}">
  <div class="drip-container">
    <div class="drip-tech__head">
      {%- if section.settings.eyebrow != blank -%}<span class="drip-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="drip-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="drip-lead">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="drip-tech__grid">
      {%- for block in section.blocks -%}
        <div class="drip-tech__card" {{ block.shopify_attributes }}>
          <span class="drip-tech__ico" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3 class="drip-tech__title">{{ block.settings.title }}</h3>
          <p class="drip-tech__desc">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- style -%}
  #drip-tech-{{ section.id }} .drip-tech__head{max-width:560px;margin:0 0 30px}
  #drip-tech-{{ section.id }} .drip-tech__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  #drip-tech-{{ section.id }} .drip-tech__card{background:#fff;border:1px solid var(--drip-line);border-radius:16px;padding:22px 18px;text-align:center;box-shadow:0 2px 12px rgba(15,23,42,.04)}
  #drip-tech-{{ section.id }} .drip-tech__ico{display:inline-grid;place-items:center;width:54px;height:54px;border-radius:50%;background:#dcfce7;font-size:24px;margin-bottom:14px}
  #drip-tech-{{ section.id }} .drip-tech__title{margin:0 0 8px;font-size:15px;font-weight:800}
  #drip-tech-{{ section.id }} .drip-tech__desc{margin:0;font-size:13px;color:var(--drip-ink);line-height:1.5}
  @media(min-width:900px){#drip-tech-{{ section.id }} .drip-tech__grid{grid-template-columns:repeat(4,1fr);gap:20px}#drip-tech-{{ section.id }} .drip-tech__card{padding:28px 20px}}
{%- endstyle -%}
{% schema %}
{
  "name": "Miotła Halloween • Technologie",
  "settings": [
    { "type":"text","id":"eyebrow","label":"Nadtytuł","default":"ROZWIĄZANIE" },
    { "type":"text","id":"heading","label":"Nagłówek","default":"Trzy efekty. Jedna miotła." },
    { "type":"textarea","id":"subheading","label":"Podnagłówek","default":"Miotła Halloween™ łączy światło, dźwięk i ruch w jednej dekoracji, która działa od razu po włączeniu." }
  ],
  "blocks": [ { "type":"feature","name":"Technologia","settings":[
    {"type":"text","id":"icon","label":"Emoji","default":"✨"},
    {"type":"text","id":"title","label":"Tytuł","default":"Świecące LED"},
    {"type":"textarea","id":"text","label":"Opis","default":"Zielona poświata w mroku tworzy magiczny, niepokojący klimat na ganku."}
  ] } ],
  "max_blocks": 8,
  "presets": [ { "name":"Miotła Halloween • Technologie", "blocks":[
    {"type":"feature","settings":{"icon":"✨","title":"Świecące LED","text":"Zielona poświata w mroku tworzy magiczny, niepokojący klimat na ganku."}},
    {"type":"feature","settings":{"icon":"🔊","title":"Złowrogi śmiech","text":"Wbudowany dźwiękowy efekt śmiechu wiedźmy włącza się jednym przyciskiem."}},
    {"type":"feature","settings":{"icon":"🕺","title":"Ruchome „nóżki”","text":"Miotła porusza się, jakby sama chodziła po ganku lub schodach."}},
    {"type":"feature","settings":{"icon":"🦯","title":"Giętki trzonek","text":"Ustaw miotłę w dowolnej pozycji — oparta, latająca czy wisząca."}}
  ] } ]
}
{% endschema %}
