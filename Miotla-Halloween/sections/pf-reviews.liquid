{%- comment -%} Miotła Halloween — Opinie: podsumowanie oceny + siatka recenzji (styl panefright) {%- endcomment -%}
<section class="pf pf-rev pf-sec pf-sec--alt" id="pf-rev-{{ section.id }}">
  <div class="pf-container">
    <div class="pf-rev__summary">
      <div class="pf-rev__score">
        <span class="pf-rev__num">{{ section.settings.rating_value }}</span>
        <span class="pf-star-row" aria-hidden="true">★★★★★</span>
        <span class="pf-rev__count">{{ section.settings.rating_count }}</span>
      </div>
      <div class="pf-rev__bars">
        {%- assign bars = "5:" | append: section.settings.pct_5 | append: ",4:" | append: section.settings.pct_4 | append: ",3:" | append: section.settings.pct_3 | append: ",2:" | append: section.settings.pct_2 | append: ",1:" | append: section.settings.pct_1 | split: "," -%}
        {%- for b in bars -%}
          {%- assign parts = b | split: ":" -%}
          <div class="pf-rev__bar">
            <span class="pf-rev__barlabel">{{ parts[0] }}★</span>
            <span class="pf-rev__bartrack"><span class="pf-rev__barfill" style="width:{{ parts[1] }}%"></span></span>
            <span class="pf-rev__barpct">{{ parts[1] }}%</span>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="pf-rev__grid">
      {%- for block in section.blocks -%}
        <figure class="pf-rev__card pf-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'pf-rev__img', alt: block.settings.name | escape }}
          {%- endif -%}
          <div class="pf-rev__body">
            {%- assign pf_empty_stars = 5 | minus: block.settings.rating -%}
            <span class="pf-star-row" aria-hidden="true">{% for i in (1..block.settings.rating) %}★{% endfor %}{% if pf_empty_stars > 0 %}{% for i in (1..pf_empty_stars) %}☆{% endfor %}{% endif %}</span>
            <p class="pf-rev__text">{{ block.settings.text }}</p>
            <span class="pf-rev__name">{{ block.settings.name }}</span>
          </div>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- style -%}
  #pf-rev-{{ section.id }} .pf-rev__summary{display:flex;flex-direction:column;gap:20px;align-items:center;text-align:center;margin-bottom:36px}
  #pf-rev-{{ section.id }} .pf-rev__score{display:flex;flex-direction:column;align-items:center;gap:6px}
  #pf-rev-{{ section.id }} .pf-rev__num{font-size:44px;font-weight:800;line-height:1}
  #pf-rev-{{ section.id }} .pf-rev__count{font-size:13px;color:var(--pf-text-dim)}
  #pf-rev-{{ section.id }} .pf-rev__bars{width:100%;max-width:280px;display:flex;flex-direction:column;gap:6px}
  #pf-rev-{{ section.id }} .pf-rev__bar{display:grid;grid-template-columns:28px 1fr 36px;align-items:center;gap:8px;font-size:11.5px;color:var(--pf-text-dim)}
  #pf-rev-{{ section.id }} .pf-rev__bartrack{height:6px;border-radius:999px;background:var(--pf-bg-card);overflow:hidden}
  #pf-rev-{{ section.id }} .pf-rev__barfill{display:block;height:100%;background:var(--pf-star)}
  #pf-rev-{{ section.id }} .pf-rev__grid{display:grid;grid-template-columns:1fr;gap:14px}
  #pf-rev-{{ section.id }} .pf-rev__card{overflow:hidden}
  #pf-rev-{{ section.id }} .pf-rev__img{width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--pf-bg-card);display:block}
  #pf-rev-{{ section.id }} .pf-rev__body{padding:14px 16px}
  #pf-rev-{{ section.id }} .pf-rev__text{margin:8px 0 10px;font-size:12.5px;color:var(--pf-text-dim);line-height:1.55}
  #pf-rev-{{ section.id }} .pf-rev__name{font-size:11.5px;font-weight:700;color:var(--pf-text)}
  @media(min-width:640px){#pf-rev-{{ section.id }} .pf-rev__grid{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:960px){#pf-rev-{{ section.id }} .pf-rev__grid{grid-template-columns:repeat(3,1fr)}#pf-rev-{{ section.id }} .pf-rev__summary{flex-direction:row;justify-content:center;gap:48px}}
{%- endstyle -%}
{% schema %}
{
  "name": "MH — Opinie",
  "settings": [
    { "type": "text", "id": "rating_value", "label": "Ocena ogólna", "default": "4,8" },
    { "type": "text", "id": "rating_count", "label": "Liczba opinii", "default": "na podstawie 263 opinii" },
    { "type": "range", "id": "pct_5", "label": "% ocen 5★", "min": 0, "max": 100, "default": 82 },
    { "type": "range", "id": "pct_4", "label": "% ocen 4★", "min": 0, "max": 100, "default": 12 },
    { "type": "range", "id": "pct_3", "label": "% ocen 3★", "min": 0, "max": 100, "default": 4 },
    { "type": "range", "id": "pct_2", "label": "% ocen 2★", "min": 0, "max": 100, "default": 1 },
    { "type": "range", "id": "pct_1", "label": "% ocen 1★", "min": 0, "max": 100, "default": 1 }
  ],
  "blocks": [
    { "type": "review", "name": "Opinia", "settings": [
      { "type": "image_picker", "id": "image", "label": "Zdjęcie (opcjonalnie)" },
      { "type": "range", "id": "rating", "label": "Ocena", "min": 1, "max": 5, "default": 5 },
      { "type": "textarea", "id": "text", "label": "Treść", "default": "Świetna dekoracja, robi ogromne wrażenie po zmroku." },
      { "type": "text", "id": "name", "label": "Autor", "default": "Anna K." }
    ] }
  ],
  "max_blocks": 18,
  "presets": [ { "name": "MH — Opinie", "blocks": [
    { "type": "review", "settings": { "rating": 5, "name": "Karolina M.", "text": "Dużo lepsza niż te tandetne dekoracje, które widać, że są sztuczne już z 5 metrów. Ta naprawdę robi wrażenie — mój mąż i dzieciaki ją uwielbiają." } },
    { "type": "review", "settings": { "rating": 5, "name": "Łukasz P.", "text": "Sąsiedzi pytali, gdzie kupiłem. Zielona poświata widoczna z drugiej strony ulicy, a dźwięk naprawdę straszy." } },
    { "type": "review", "settings": { "rating": 5, "name": "Ania W.", "text": "Montaż zajął dosłownie 2 minuty. Giętki trzonek pozwolił ułożyć miotłę dokładnie tak, jak chciałam." } },
    { "type": "review", "settings": { "rating": 4, "name": "Marek Sz.", "text": "Bardzo dobra jakość jak na tę cenę. Jedyny minus — baterie trzeba dokupić osobno." } },
    { "type": "review", "settings": { "rating": 5, "name": "Kasia D.", "text": "Dzieci z całej ulicy przychodzą zobaczyć, jak miotła się rusza i śmieje. Najlepszy zakup na Halloween." } },
    { "type": "review", "settings": { "rating": 5, "name": "Tomek R.", "text": "Wygląda dokładnie jak na zdjęciach — świeci mocno i naprawdę robi wrażenie po zmroku." } },
    { "type": "review", "settings": { "rating": 5, "name": "Ola J.", "text": "Kupiłam dwie sztuki — jedną na drzwi, drugą do ogrodu. Obie działają bez zarzutu." } },
    { "type": "review", "settings": { "rating": 5, "name": "Bartek K.", "text": "Najlepsza dekoracja Halloweenowa, jaką miałem. Ruch nóżek robi niesamowite wrażenie." } },
    { "type": "review", "settings": { "rating": 4, "name": "Magda T.", "text": "Solidne wykonanie, dźwięk głośniejszy niż się spodziewałam — w pozytywnym sensie." } },
    { "type": "review", "settings": { "rating": 5, "name": "Piotr N.", "text": "Przesyłka szybka, a jakość zaskoczyła mnie pozytywnie. Polecam każdemu, kto lubi Halloween." } },
    { "type": "review", "settings": { "rating": 5, "name": "Ewa L.", "text": "Genialny prezent-niespodzianka dla dzieci. Same pytały, czy miotła jest zaczarowana." } },
    { "type": "review", "settings": { "rating": 5, "name": "Damian F.", "text": "Świetna zabawa dla całej rodziny — montaż banalny, efekt piorunujący." } }
  ] } ]
}
{% endschema %}
