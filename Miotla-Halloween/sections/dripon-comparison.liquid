{%- comment -%} Miotła Halloween — Porównanie (styl THEVIREA) {%- endcomment -%}
<section class="drip-cmp drip-sec" id="drip-cmp-{{ section.id }}">
  <div class="drip-container">
    <div class="drip-cmp__head">
      {%- if section.settings.eyebrow != blank -%}<span class="drip-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="drip-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="drip-lead">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="drip-cmp__cols">
      <div class="drip-cmp__col drip-cmp__col--bad">
        <div class="drip-cmp__bar drip-cmp__bar--bad">😣 {{ section.settings.left_title }}</div>
        {%- if section.settings.left_image != blank -%}
          {{ section.settings.left_image | image_url: width:800 | image_tag: loading:'lazy', class:'drip-cmp__img', alt: section.settings.left_title | escape }}
        {%- else -%}<span class="drip-cmp__ph"></span>{%- endif -%}
        <ul class="drip-cmp__list">
          {%- for block in section.blocks -%}{%- if block.type == 'left' -%}
            <li {{ block.shopify_attributes }}><span class="drip-cmp__x" aria-hidden="true">✕</span>{{ block.settings.text }}</li>
          {%- endif -%}{%- endfor -%}
        </ul>
      </div>
      <div class="drip-cmp__col drip-cmp__col--good">
        <div class="drip-cmp__bar drip-cmp__bar--good">✅ {{ section.settings.right_title }}</div>
        {%- if section.settings.right_image != blank -%}
          {{ section.settings.right_image | image_url: width:800 | image_tag: loading:'lazy', class:'drip-cmp__img', alt: section.settings.right_title | escape }}
        {%- else -%}<span class="drip-cmp__ph"></span>{%- endif -%}
        <ul class="drip-cmp__list">
          {%- for block in section.blocks -%}{%- if block.type == 'right' -%}
            <li {{ block.shopify_attributes }}><span class="drip-cmp__v" aria-hidden="true">✓</span>{{ block.settings.text }}</li>
          {%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>
{%- style -%}
  #drip-cmp-{{ section.id }} .drip-cmp__head{max-width:560px;margin:0 0 30px}
  #drip-cmp-{{ section.id }} .drip-cmp__cols{display:grid;grid-template-columns:1fr;gap:16px}
  #drip-cmp-{{ section.id }} .drip-cmp__col{background:#fff;border:1px solid var(--drip-line);border-radius:18px;overflow:hidden}
  #drip-cmp-{{ section.id }} .drip-cmp__col--good{border:2px solid var(--drip-blue);box-shadow:0 14px 30px rgba(34,197,94,.12)}
  #drip-cmp-{{ section.id }} .drip-cmp__bar{padding:12px 18px;font-weight:800;font-size:15px}
  #drip-cmp-{{ section.id }} .drip-cmp__bar--bad{background:#f4f6fb;color:var(--drip-navy)}
  #drip-cmp-{{ section.id }} .drip-cmp__bar--good{background:var(--drip-blue);color:#fff}
  #drip-cmp-{{ section.id }} .drip-cmp__img,#drip-cmp-{{ section.id }} .drip-cmp__ph{width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--drip-bg);display:block}
  #drip-cmp-{{ section.id }} .drip-cmp__list{list-style:none;margin:0;padding:8px 0}
  #drip-cmp-{{ section.id }} .drip-cmp__list li{display:flex;align-items:flex-start;gap:10px;font-size:14px;padding:11px 18px;border-top:1px solid #f1f4f9}
  #drip-cmp-{{ section.id }} .drip-cmp__x{flex:none;width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:#fde4e6;color:var(--drip-red);font-size:11px;font-weight:800}
  #drip-cmp-{{ section.id }} .drip-cmp__v{flex:none;width:20px;height:20px;display:grid;place-items:center;border-radius:50%;background:var(--drip-green);color:#fff;font-size:11px;font-weight:800}
  @media(min-width:900px){#drip-cmp-{{ section.id }} .drip-cmp__cols{grid-template-columns:1fr 1fr;gap:24px}}
{%- endstyle -%}
{% schema %}
{
  "name": "Miotła Halloween • Porównanie",
  "settings": [
    { "type":"text","id":"eyebrow","label":"Nadtytuł","default":"PORÓWNANIE" },
    { "type":"text","id":"heading","label":"Nagłówek","default":"Dlaczego zwykła dekoracja nie wystarcza?" },
    { "type":"textarea","id":"subheading","label":"Podnagłówek","default":"Zobacz różnicę między tradycyjną dekoracją a Miotłą Halloween™." },
    { "type":"text","id":"left_title","label":"Tytuł — lewa","default":"Zwykła dekoracja" },
    { "type":"image_picker","id":"left_image","label":"Zdjęcie — lewa" },
    { "type":"text","id":"right_title","label":"Tytuł — prawa","default":"Miotła Halloween™" },
    { "type":"image_picker","id":"right_image","label":"Zdjęcie — prawa" }
  ],
  "blocks": [
    { "type":"left","name":"Wada (lewa)","settings":[ {"type":"text","id":"text","label":"Tekst","default":"statyczna, bez ruchu"} ] },
    { "type":"right","name":"Zaleta (prawa)","settings":[ {"type":"text","id":"text","label":"Tekst","default":"animowana, świeci i mówi"} ] }
  ],
  "presets": [ { "name":"Miotła Halloween • Porównanie", "blocks":[
    {"type":"left","settings":{"text":"Statyczna, bez ruchu"}},
    {"type":"left","settings":{"text":"Brak dźwięku i efektu WOW"}},
    {"type":"left","settings":{"text":"Skomplikowany montaż"}},
    {"type":"left","settings":{"text":"Słaba widoczność w nocy"}},
    {"type":"left","settings":{"text":"Szybko się nudzi gościom"}},
    {"type":"right","settings":{"text":"Animowane ruchome „nóżki”"}},
    {"type":"right","settings":{"text":"Dźwięk złowrogiego śmiechu"}},
    {"type":"right","settings":{"text":"Montaż w minutę"}},
    {"type":"right","settings":{"text":"Świeci na zielono w ciemności"}},
    {"type":"right","settings":{"text":"Przyciąga wzrok całej ulicy"}}
  ] } ]
}
{% endschema %}
