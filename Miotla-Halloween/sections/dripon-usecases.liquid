{%- comment -%} Miotła Halloween — Dopasowanie (slider, styl THEVIREA) {%- endcomment -%}
<section class="drip-use drip-sec" id="drip-use-{{ section.id }}">
  <div class="drip-container">
    <div class="drip-use__head">
      {%- if section.settings.eyebrow != blank -%}<span class="drip-eyebrow drip-eyebrow--amber">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="drip-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="drip-lead">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
  </div>
  <div class="drip-container drip-use__wrap">
    <button class="drip-arrow drip-arrow--prev" type="button" data-dir="-1" aria-label="Poprzednie">‹</button>
    <div class="drip-use__track" id="drip-use-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="drip-use__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width:700 | image_tag: loading:'lazy', class:'drip-use__img', alt: block.settings.title | escape }}
          {%- else -%}<span class="drip-use__ph"></span>{%- endif -%}
          <div class="drip-use__body">
            <h3 class="drip-use__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="drip-use__desc">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    <button class="drip-arrow drip-arrow--next" type="button" data-dir="1" aria-label="Następne">›</button>
  </div>
</section>
{%- style -%}
  #drip-use-{{ section.id }} .drip-use__head{max-width:560px;margin:0 0 26px}
  #drip-use-{{ section.id }} .drip-use__wrap{position:relative}
  #drip-use-{{ section.id }} .drip-use__track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:4px 0}
  #drip-use-{{ section.id }} .drip-use__track::-webkit-scrollbar{display:none}
  #drip-use-{{ section.id }} .drip-use__card{flex:0 0 82%;scroll-snap-align:center;background:#fff;border:1px solid var(--drip-line);border-radius:18px;overflow:hidden;box-shadow:0 2px 12px rgba(15,23,42,.05)}
  #drip-use-{{ section.id }} .drip-use__img,#drip-use-{{ section.id }} .drip-use__ph{width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--drip-bg);display:block}
  #drip-use-{{ section.id }} .drip-use__body{padding:18px 20px}
  #drip-use-{{ section.id }} .drip-use__title{margin:0 0 6px;font-size:18px;font-weight:800}
  #drip-use-{{ section.id }} .drip-use__desc{margin:0;font-size:14px;color:var(--drip-ink);line-height:1.55}
  #drip-use-{{ section.id }} .drip-arrow{position:absolute;top:42%;transform:translateY(-50%);z-index:2;width:42px;height:42px;border-radius:50%;border:0;background:#fff;color:var(--drip-navy);font-size:24px;cursor:pointer;box-shadow:0 4px 14px rgba(15,23,42,.18);display:grid;place-items:center}
  #drip-use-{{ section.id }} .drip-arrow--prev{left:-6px}
  #drip-use-{{ section.id }} .drip-arrow--next{right:-6px}
  @media(min-width:900px){
    #drip-use-{{ section.id }} .drip-use__card{flex-basis:calc((100% - 32px)/3)}
    #drip-use-{{ section.id }} .drip-arrow{display:grid;place-items:center}
  }
{%- endstyle -%}
<script>
(function(){var t=document.getElementById('drip-use-track-{{ section.id }}');if(!t)return;
  document.querySelectorAll('#drip-use-{{ section.id }} .drip-arrow').forEach(function(b){b.addEventListener('click',function(){t.scrollBy({left:t.clientWidth*0.85*parseInt(b.getAttribute('data-dir'),10),behavior:'smooth'})})});})();
</script>
{% schema %}
{
  "name": "Miotła Halloween • Dopasowanie",
  "settings": [
    { "type":"text","id":"eyebrow","label":"Nadtytuł","default":"DOPASOWANIE" },
    { "type":"text","id":"heading","label":"Nagłówek","default":"Do każdego zakątka domu" },
    { "type":"textarea","id":"subheading","label":"Podnagłówek","default":"Jedna miotła, dziesiątki sposobów na straszenie — na zewnątrz i w środku." }
  ],
  "blocks": [ { "type":"usecase","name":"Zastosowanie","settings":[
    {"type":"image_picker","id":"image","label":"Zdjęcie"},
    {"type":"text","id":"title","label":"Tytuł","default":"Drzwi wejściowe?"},
    {"type":"textarea","id":"text","label":"Opis","default":"Zawieś przy wejściu, żeby witała gości złowrogim śmiechem i zielonym blaskiem."}
  ] } ],
  "max_blocks": 8,
  "presets": [ { "name":"Miotła Halloween • Dopasowanie", "blocks":[
    {"type":"usecase","settings":{"title":"Drzwi wejściowe?","text":"Zawieś przy wejściu, żeby witała gości złowrogim śmiechem i zielonym blaskiem."}},
    {"type":"usecase","settings":{"title":"Ganek i schody?","text":"Oprzyj o poręcz — dzięki giętkiemu trzonkowi utrzyma dowolną pozycję."}},
    {"type":"usecase","settings":{"title":"Impreza Halloweenowa?","text":"Ustaw jako centralny punkt dekoracji lub rekwizyt do zdjęć."}}
  ] } ]
}
{% endschema %}
