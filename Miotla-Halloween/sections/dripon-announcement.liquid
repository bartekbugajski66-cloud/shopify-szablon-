{%- comment -%} Miotła Halloween — pasek benefitów (rotacja co 5s) {%- endcomment -%}
<div class="drip-ann" id="drip-ann-{{ section.id }}" data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="drip-ann__rotator" role="status" aria-live="polite">
    {%- for block in section.blocks -%}
      <span class="drip-ann__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
        <strong>{{ block.settings.text }}</strong>
      </span>
    {%- endfor -%}
  </div>
</div>
{%- style -%}
  #drip-ann-{{ section.id }}{background:var(--drip-blue);color:#fff;font-size:13.5px}
  #drip-ann-{{ section.id }} .drip-ann__rotator{position:relative;max-width:1200px;margin:0 auto;padding:11px 16px;min-height:42px;display:flex;align-items:center;justify-content:center}
  #drip-ann-{{ section.id }} .drip-ann__item{position:absolute;left:0;right:0;display:flex;align-items:center;justify-content:center;gap:8px;font-weight:700;opacity:0;transition:opacity .4s ease;pointer-events:none}
  #drip-ann-{{ section.id }} .drip-ann__item.is-active{opacity:1;position:relative}
{%- endstyle -%}
<script>
(function(){
  var box=document.getElementById('drip-ann-{{ section.id }}');if(!box)return;
  var items=box.querySelectorAll('.drip-ann__item');if(items.length<2)return;
  var i=0,ms=parseInt(box.getAttribute('data-interval'),10)||5000;
  setInterval(function(){
    items[i].classList.remove('is-active');
    i=(i+1)%items.length;
    items[i].classList.add('is-active');
  },ms);
})();
</script>
{% schema %}
{
  "name": "Miotła Halloween • Pasek benefitów",
  "settings": [
    { "type":"range","id":"interval","min":2,"max":10,"step":1,"unit":"s","label":"Co ile zmieniać benefit","default":5 }
  ],
  "blocks": [ { "type":"benefit","name":"Benefit","settings":[ {"type":"text","id":"icon","label":"Emoji","default":"🔥"}, {"type":"text","id":"text","label":"Tekst","default":"Ekspresowa dostawa"} ] } ],
  "presets": [ { "name":"Miotła Halloween • Pasek benefitów", "blocks":[
    {"type":"benefit","settings":{"icon":"🔥","text":"Okazja: oszczędzasz do 60 zł"}},
    {"type":"benefit","settings":{"icon":"🚚","text":"Ekspresowa dostawa"}},
    {"type":"benefit","settings":{"icon":"🛡️","text":"30 dni na przetestowanie"}},
    {"type":"benefit","settings":{"icon":"🔒","text":"Bezpieczne płatności"}}
  ] } ]
}
{% endschema %}
