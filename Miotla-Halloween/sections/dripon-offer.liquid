{%- comment -%}
  Miotła Halloween — Wybór zestawu + upsell + CTA do koszyka
  Działa na szablonie produktu (ma dostęp do obiektu `product`).
  Każdy pakiet (block) wskazuje wariant Shopify po ID oraz ilość sztuk.
{%- endcomment -%}
<section
  class="drip-offer"
  id="drip-offer"
  data-section-id="{{ section.id }}"
  data-after-add="{{ section.settings.after_add }}"
  style="--drip-accent: {{ section.settings.accent_color }}; --drip-bg: {{ section.settings.bg_color }}; --drip-text: {{ section.settings.text_color }}; --drip-old: {{ section.settings.compare_color }};"
>
  <div class="drip-offer__wrap page-width">
    {%- if section.settings.eyebrow != blank -%}<span class="drip-offer__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="drip-offer__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="drip-offer__sub">{{ section.settings.subheading }}</p>{%- endif -%}

    <form class="drip-offer__form" id="drip-offer-form-{{ section.id }}">
      <fieldset class="drip-offer__packs">
        <legend class="visually-hidden">Wybierz pakiet Miotła Halloween</legend>
        {%- for block in section.blocks -%}
          {%- if block.type == 'package' -%}
            {%- assign vid = block.settings.variant_id | default: product.selected_or_first_available_variant.id -%}
            <label class="drip-offer__pack{% if block.settings.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.badge != blank -%}<span class="drip-offer__packbadge">{{ block.settings.badge }}</span>{%- endif -%}
              <input
                type="radio"
                name="drip-pack"
                class="drip-offer__radio"
                value="{{ vid }}"
                data-qty="{{ block.settings.quantity | default: 1 }}"
                {% if block.settings.preselect %}checked{% endif %}
              >
              <span class="drip-offer__packbody">
                <span class="drip-offer__packtop">
                  <span class="drip-offer__dot" aria-hidden="true"></span>
                  <span class="drip-offer__packtitle">{{ block.settings.title }}</span>
                </span>
                {%- if block.settings.desc != blank -%}<span class="drip-offer__packdesc">{{ block.settings.desc }}</span>{%- endif -%}
              </span>
              <span class="drip-offer__packprice">
                <span class="drip-offer__price">{{ block.settings.price }}</span>
                {%- if block.settings.compare_price != blank -%}<span class="drip-offer__old">{{ block.settings.compare_price }}</span>{%- endif -%}
              </span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </fieldset>

      {%- if section.settings.upsell_enable -%}
        <label class="drip-offer__upsell">
          <input type="checkbox" id="drip-upsell-{{ section.id }}" class="drip-offer__upcheck"
            data-variant="{{ section.settings.upsell_variant_id }}" data-qty="{{ section.settings.upsell_qty | default: 1 }}">
          <span class="drip-offer__upbody">
            <strong class="drip-offer__uptitle">{{ section.settings.upsell_title }}</strong>
            <span class="drip-offer__uptext">{{ section.settings.upsell_text }}</span>
          </span>
          {%- if section.settings.upsell_price != blank -%}<span class="drip-offer__upprice">{{ section.settings.upsell_price }}</span>{%- endif -%}
        </label>
      {%- endif -%}

      <button type="submit" class="drip-offer__cta" id="drip-offer-cta-{{ section.id }}">
        <span class="drip-offer__ctatext">{{ section.settings.cta_text }}</span>
        <span class="drip-offer__ctaspin" aria-hidden="true"></span>
      </button>
      <p class="drip-offer__err" id="drip-offer-err-{{ section.id }}" role="alert" hidden></p>

      <ul class="drip-offer__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' -%}
            <li {{ block.shopify_attributes }}><span aria-hidden="true">{{ block.settings.icon }}</span> {{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </form>
  </div>
</section>

{%- style -%}
  #drip-offer { background: var(--drip-bg); color: var(--drip-text); scroll-margin-top: 70px; }
  #drip-offer .drip-offer__wrap { max-width: 620px; margin: 0 auto; padding: 44px 16px; }
  #drip-offer .drip-offer__eyebrow { display: block; text-align: center; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--drip-accent); margin-bottom: 8px; }
  #drip-offer .drip-offer__title { text-align: center; font-size: clamp(24px, 6vw, 32px); font-weight: 800; line-height: 1.2; margin: 0 0 8px; }
  #drip-offer .drip-offer__sub { text-align: center; opacity: .8; font-size: 15px; margin: 0 0 24px; }
  #drip-offer .drip-offer__packs { border: 0; padding: 0; margin: 0 0 14px; display: flex; flex-direction: column; gap: 12px; }
  #drip-offer .drip-offer__pack {
    position: relative; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px;
    background: #fff; border: 2px solid #e6eaf2; border-radius: 16px; padding: 16px 18px; cursor: pointer;
    transition: border-color .15s, box-shadow .15s;
  }
  #drip-offer .drip-offer__pack:has(.drip-offer__radio:checked) { border-color: var(--drip-accent); box-shadow: 0 8px 22px rgba(34,197,94,.16); }
  #drip-offer .drip-offer__pack.is-highlight { border-color: var(--drip-accent); }
  #drip-offer .drip-offer__packbadge { position: absolute; top: -11px; left: 18px; background: var(--drip-accent); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .03em; padding: 4px 11px; border-radius: 999px; }
  #drip-offer .drip-offer__radio { position: absolute; opacity: 0; pointer-events: none; }
  #drip-offer .drip-offer__packbody { display: flex; flex-direction: column; gap: 3px; }
  #drip-offer .drip-offer__packtop { display: flex; align-items: center; gap: 10px; }
  #drip-offer .drip-offer__dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #cbd5e1; flex: none; position: relative; transition: border-color .15s; }
  #drip-offer .drip-offer__pack:has(.drip-offer__radio:checked) .drip-offer__dot { border-color: var(--drip-accent); }
  #drip-offer .drip-offer__pack:has(.drip-offer__radio:checked) .drip-offer__dot::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--drip-accent); }
  #drip-offer .drip-offer__packtitle { font-size: 16px; font-weight: 700; }
  #drip-offer .drip-offer__packdesc { font-size: 13px; opacity: .7; padding-left: 30px; }
  #drip-offer .drip-offer__packprice { text-align: right; display: flex; flex-direction: column; }
  #drip-offer .drip-offer__price { font-size: 18px; font-weight: 800; }
  #drip-offer .drip-offer__old { font-size: 13px; color: var(--drip-old); text-decoration: line-through; }
  #drip-offer .drip-offer__upsell { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; background: #fff; border: 1px dashed #cbd5e1; border-radius: 14px; padding: 14px 16px; margin: 0 0 18px; cursor: pointer; }
  #drip-offer .drip-offer__upcheck { width: 20px; height: 20px; accent-color: var(--drip-accent); flex: none; }
  #drip-offer .drip-offer__upbody { display: flex; flex-direction: column; gap: 2px; }
  #drip-offer .drip-offer__uptitle { font-size: 14px; }
  #drip-offer .drip-offer__uptext { font-size: 12.5px; opacity: .7; }
  #drip-offer .drip-offer__upprice { font-weight: 700; font-size: 14px; color: var(--drip-accent); }
  #drip-offer .drip-offer__cta {
    width: 100%; border: 0; cursor: pointer; background: var(--drip-accent); color: #fff;
    font-weight: 800; font-size: 16px; padding: 17px 20px; border-radius: 14px;
    box-shadow: 0 10px 24px rgba(34,197,94,.30); display: flex; align-items: center; justify-content: center; gap: 10px;
    transition: filter .15s, transform .1s;
  }
  #drip-offer .drip-offer__cta:hover { filter: brightness(1.06); }
  #drip-offer .drip-offer__cta:active { transform: scale(.99); }
  #drip-offer .drip-offer__cta[aria-busy="true"] { opacity: .8; pointer-events: none; }
  #drip-offer .drip-offer__ctaspin { display: none; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.5); border-top-color: #fff; border-radius: 50%; animation: dripSpin .7s linear infinite; }
  #drip-offer .drip-offer__cta[aria-busy="true"] .drip-offer__ctaspin { display: inline-block; }
  @keyframes dripSpin { to { transform: rotate(360deg); } }
  #drip-offer .drip-offer__err { color: #D93B35; font-size: 13px; text-align: center; margin: 10px 0 0; }
  #drip-offer .drip-offer__trust { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  #drip-offer .drip-offer__trust li { font-size: 12.5px; font-weight: 600; opacity: .8; display: inline-flex; align-items: center; gap: 5px; }
  .visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 750px) { #drip-offer .drip-offer__wrap { padding: 64px 24px; } }
{%- endstyle -%}

<script>
  (function () {
    var form = document.getElementById('drip-offer-form-{{ section.id }}');
    if (!form) return;
    var section = document.getElementById('drip-offer');
    var cta = document.getElementById('drip-offer-cta-{{ section.id }}');
    var err = document.getElementById('drip-offer-err-{{ section.id }}');
    var afterAdd = section.getAttribute('data-after-add') || 'cart';

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      err.hidden = true;

      var picked = form.querySelector('input[name="drip-pack"]:checked');
      if (!picked || !picked.value) {
        err.textContent = 'Wybierz pakiet, aby kontynuować.';
        err.hidden = false;
        return;
      }

      var items = [{ id: parseInt(picked.value, 10), quantity: parseInt(picked.getAttribute('data-qty') || '1', 10) }];

      var up = document.getElementById('drip-upsell-{{ section.id }}');
      if (up && up.checked && up.getAttribute('data-variant')) {
        items.push({ id: parseInt(up.getAttribute('data-variant'), 10), quantity: parseInt(up.getAttribute('data-qty') || '1', 10) });
      }

      cta.setAttribute('aria-busy', 'true');

      fetch(window.Shopify && window.Shopify.routes ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
          if (!res.ok) { throw new Error(res.data && res.data.description ? res.data.description : 'Nie udało się dodać do koszyka.'); }
          if (afterAdd === 'checkout') { window.location.href = '/checkout'; }
          else { window.location.href = window.Shopify && window.Shopify.routes ? window.Shopify.routes.root + 'cart' : '/cart'; }
        })
        .catch(function (e2) {
          cta.removeAttribute('aria-busy');
          err.textContent = e2.message || 'Wystąpił błąd. Spróbuj ponownie.';
          err.hidden = false;
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Miotła Halloween • Oferta / zestawy",
  "tag": "section",
  "class": "drip-section drip-section--offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "Wybierz zestaw" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Zamów Miotła Halloween w promocji" },
    { "type": "textarea", "id": "subheading", "label": "Podnagłówek", "default": "Im większy zestaw, tym niższa cena za sztukę. Oferta ograniczona czasowo." },
    { "type": "text", "id": "cta_text", "label": "Tekst przycisku CTA", "default": "Zamawiam Miotłę Halloween — chcę przestraszyć sąsiadów" },
    {
      "type": "select", "id": "after_add", "label": "Po dodaniu do koszyka", "default": "cart",
      "options": [ { "value": "cart", "label": "Przejdź do koszyka" }, { "value": "checkout", "label": "Przejdź do kasy" } ]
    },
    { "type": "header", "content": "Upsell (sekcja 14)" },
    { "type": "checkbox", "id": "upsell_enable", "label": "Pokaż upsell", "default": true },
    { "type": "text", "id": "upsell_title", "label": "Tytuł upsell", "default": "TAK, dobieram drugą miotłę w promocyjnej cenie" },
    { "type": "textarea", "id": "upsell_text", "label": "Opis upsell", "default": "Powieś jedną na drzwiach, drugą postaw w ogrodzie lub na balkonie." },
    { "type": "text", "id": "upsell_price", "label": "Cena upsell (tekst)", "default": "+39 zł" },
    { "type": "text", "id": "upsell_variant_id", "label": "ID wariantu upsell", "info": "Wklej numeryczne ID wariantu Shopify, który ma zostać dodany przy zaznaczeniu." },
    { "type": "number", "id": "upsell_qty", "label": "Ilość upsell", "default": 1 },
    { "type": "header", "content": "Kolory" },
    { "type": "color", "id": "accent_color", "label": "Akcent / CTA", "default": "#16A34A" },
    { "type": "color", "id": "bg_color", "label": "Tło", "default": "#F5F7FB" },
    { "type": "color", "id": "text_color", "label": "Tekst", "default": "#0F172A" },
    { "type": "color", "id": "compare_color", "label": "Kolor ceny przekreślonej", "default": "#94A3B8" }
  ],
  "blocks": [
    {
      "type": "package",
      "name": "Pakiet",
      "settings": [
        { "type": "text", "id": "title", "label": "Tytuł", "default": "2 sztuki — Para na Drzwi" },
        { "type": "text", "id": "desc", "label": "Opis", "default": "Najczęściej wybierany zestaw" },
        { "type": "text", "id": "badge", "label": "Badge (opcjonalnie)", "default": "Najpopularniejsze" },
        { "type": "text", "id": "price", "label": "Cena promocyjna", "default": "119,98 zł" },
        { "type": "text", "id": "compare_price", "label": "Cena przekreślona", "default": "199,98 zł" },
        { "type": "text", "id": "variant_id", "label": "ID wariantu Shopify", "info": "Numeryczne ID wariantu, który ma trafić do koszyka. Puste = pierwszy dostępny wariant produktu." },
        { "type": "number", "id": "quantity", "label": "Ilość sztuk dodawanych do koszyka", "default": 1 },
        { "type": "checkbox", "id": "highlight", "label": "Wyróżnij ramką", "default": false },
        { "type": "checkbox", "id": "preselect", "label": "Zaznacz domyślnie", "default": false }
      ]
    },
    {
      "type": "trust",
      "name": "Ikonka zaufania (pod CTA)",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ikona (emoji)", "default": "🚚" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Darmowa dostawa" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Miotła Halloween • Oferta / zestawy",
      "blocks": [
        { "type": "package", "settings": { "title": "1 szt. — Miotła Solo", "desc": "Do jednych drzwi", "badge": "", "price": "69,99 zł", "compare_price": "99,99 zł", "quantity": 1, "preselect": false } },
        { "type": "package", "settings": { "title": "2 szt. — Para na Drzwi", "desc": "Najczęściej wybierany", "badge": "Najpopularniejsze", "price": "119,98 zł", "compare_price": "199,98 zł", "quantity": 2, "highlight": true, "preselect": true } },
        { "type": "package", "settings": { "title": "3 szt. — Zestaw Sąsiedzki", "desc": "Największa oszczędność", "badge": "", "price": "159,97 zł", "compare_price": "299,97 zł", "quantity": 3, "preselect": false } },
        { "type": "trust", "settings": { "icon": "🚚", "text": "Darmowa dostawa" } },
        { "type": "trust", "settings": { "icon": "🛡️", "text": "30 dni na test" } },
        { "type": "trust", "settings": { "icon": "🔒", "text": "Bezpieczne płatności" } }
      ]
    }
  ]
}
{% endschema %}
