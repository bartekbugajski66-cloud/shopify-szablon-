{%- comment -%} Miotła Halloween — Header (styl THEVIREA) {%- endcomment -%}
<header class="drip-header" id="drip-header-{{ section.id }}">
  <div class="drip-container drip-header__inner">
    <details class="drip-header__drawer">
      <summary class="drip-header__burger" aria-label="Menu"><span></span><span></span><span></span></summary>
      <nav class="drip-header__mobilenav" aria-label="Menu mobilne">
        {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </nav>
    </details>

    <a href="{{ routes.root_url }}" class="drip-header__logo">
      {%- if section.settings.logo_image != blank -%}
        {%- assign logo_alt = shop.name | escape -%}
        {{ section.settings.logo_image | image_url: width: 600 | image_tag: loading: 'eager', class: 'drip-header__logoimg', widths: '150,300,450,600', alt: logo_alt }}
      {%- else -%}
        <span class="drip-header__name">{{ section.settings.logo_text | default: shop.name }}</span>
        {%- if section.settings.tagline != blank -%}<span class="drip-header__tag">{{ section.settings.tagline }}</span>{%- endif -%}
      {%- endif -%}
    </a>

    <nav class="drip-header__nav" aria-label="Menu główne">
      {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    </nav>

    <a href="{{ routes.cart_url }}" class="drip-header__cart" aria-label="Koszyk ({{ cart.item_count }})">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 7h12l-1.2 11.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 7Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
      {%- if cart.item_count > 0 -%}<span class="drip-header__count">{{ cart.item_count }}</span>{%- endif -%}
    </a>
  </div>
</header>
{%- style -%}
  #drip-header-{{ section.id }}{background:#fff;border-bottom:1px solid var(--drip-line);position:relative;z-index:50}
  #drip-header-{{ section.id }} .drip-header__inner{display:flex;align-items:center;gap:14px;padding-top:12px;padding-bottom:12px}
  #drip-header-{{ section.id }} .drip-header__logo{margin:0 auto;text-decoration:none;color:var(--drip-navy);line-height:1.05;display:block}
  #drip-header-{{ section.id }} .drip-header__logoimg{height:{{ section.settings.logo_height }}px;width:auto;display:block}
  #drip-header-{{ section.id }} .drip-header__name{display:block;font-size:21px;font-weight:800;letter-spacing:-.01em;text-align:center}
  #drip-header-{{ section.id }} .drip-header__tag{display:block;font-size:9.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--drip-ink);text-align:center}
  #drip-header-{{ section.id }} .drip-header__nav{display:none;gap:28px}
  #drip-header-{{ section.id }} .drip-header__nav a{color:var(--drip-navy);text-decoration:none;font-size:15px;font-weight:600}
  #drip-header-{{ section.id }} .drip-header__nav a:hover{color:var(--drip-blue)}
  #drip-header-{{ section.id }} .drip-header__cart{position:relative;color:var(--drip-navy);display:inline-flex;padding:4px;flex:none}
  #drip-header-{{ section.id }} .drip-header__count{position:absolute;top:-4px;right:-6px;background:var(--drip-red);color:#fff;font-size:10.5px;font-weight:700;min-width:17px;height:17px;border-radius:999px;display:grid;place-items:center;padding:0 4px}
  #drip-header-{{ section.id }} .drip-header__burger{list-style:none;cursor:pointer;display:flex;flex-direction:column;gap:4.5px;padding:6px 4px;flex:none}
  #drip-header-{{ section.id }} .drip-header__burger::-webkit-details-marker{display:none}
  #drip-header-{{ section.id }} .drip-header__burger span{width:20px;height:2px;background:var(--drip-navy);border-radius:2px;display:block}
  #drip-header-{{ section.id }} .drip-header__mobilenav{position:absolute;top:calc(100% + 8px);left:16px;min-width:220px;background:#fff;border:1px solid var(--drip-line);border-radius:14px;box-shadow:0 12px 30px rgba(15,23,42,.12);display:flex;flex-direction:column;padding:8px;z-index:60}
  #drip-header-{{ section.id }} .drip-header__mobilenav a{color:var(--drip-navy);text-decoration:none;font-size:15px;font-weight:600;padding:11px 14px;border-radius:10px}
  #drip-header-{{ section.id }} .drip-header__mobilenav a:hover{background:var(--drip-bg)}
  @media(min-width:900px){
    #drip-header-{{ section.id }} .drip-header__drawer{display:none}
    #drip-header-{{ section.id }} .drip-header__nav{display:flex}
    #drip-header-{{ section.id }} .drip-header__logo{margin:0 auto 0 0}
    #drip-header-{{ section.id }} .drip-header__name,#drip-header-{{ section.id }} .drip-header__tag{text-align:left}
  }
{%- endstyle -%}
{% schema %}
{
  "name": "Miotła Halloween • Header",
  "settings": [
    { "type":"image_picker","id":"logo_image","label":"Logo (obrazek) — zostaw puste dla tekstu" },
    { "type":"range","id":"logo_height","min":24,"max":70,"step":2,"unit":"px","label":"Wysokość logo","default":40 },
    { "type":"text","id":"logo_text","label":"Logo (tekst, gdy brak obrazka)","default":"Miotła Halloween™" },
    { "type":"text","id":"tagline","label":"Tagline pod logo","default":"MAGICZNE DEKORACJE NA HALLOWEEN" },
    { "type":"link_list","id":"menu","label":"Menu","default":"main-menu" }
  ]
}
{% endschema %}
