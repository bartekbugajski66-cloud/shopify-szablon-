{%- comment -%}
  WMXR — Baner „2 gratisy" · samodzielna sekcja (działa w każdym motywie OS 2.0).
  Własne kolory (nie zależy od motywu). Edytujesz gratisy w edytorze.
{%- endcomment -%}
<div class="wgr-sec" id="wgr-{{ section.id }}">
  <div class="wgr">
    {%- if section.settings.eyebrow != blank -%}
      <span class="wgr__eyebrow"><span class="wgr__dot" aria-hidden="true"></span>{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h3 class="wgr__title">{{ section.settings.title_before }}{% if section.settings.title_accent != blank %} <span>{{ section.settings.title_accent }}</span>{% endif %}</h3>
    <ul class="wgr__list">
      {%- if section.settings.g1_title != blank -%}<li><span class="wgr__ico" aria-hidden="true">{{ section.settings.g1_icon }}</span><span class="wgr__name">{{ section.settings.g1_title }}</span>{% if section.settings.g1_value != blank %}<span class="wgr__val">{{ section.settings.g1_value }}</span>{% endif %}</li>{%- endif -%}
      {%- if section.settings.g2_title != blank -%}<li><span class="wgr__ico" aria-hidden="true">{{ section.settings.g2_icon }}</span><span class="wgr__name">{{ section.settings.g2_title }}</span>{% if section.settings.g2_value != blank %}<span class="wgr__val">{{ section.settings.g2_value }}</span>{% endif %}</li>{%- endif -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="wgr__note">● {{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>

{%- style -%}
  #wgr-{{ section.id }}{padding:{{ section.settings.pad_top }}px 16px {{ section.settings.pad_bottom }}px}
  #wgr-{{ section.id }} .wgr{position:relative;overflow:hidden;max-width:{{ section.settings.max_width }}px;margin:0 auto;background:linear-gradient(135deg,#0e1f38 0%,#1a2f52 60%,#20365e 100%);border:1px solid rgba(255,201,77,.28);border-radius:18px;padding:20px 20px 18px;box-shadow:0 16px 34px -18px rgba(14,31,56,.6);font-family:inherit;box-sizing:border-box}
  #wgr-{{ section.id }} .wgr *{box-sizing:border-box}
  #wgr-{{ section.id }} .wgr::before{content:"🎁";position:absolute;right:-8px;top:-14px;font-size:80px;opacity:.10;transform:rotate(12deg);pointer-events:none}
  #wgr-{{ section.id }} .wgr__eyebrow{position:relative;display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#ffc94d;margin:0 0 8px}
  #wgr-{{ section.id }} .wgr__dot{width:8px;height:8px;border-radius:50%;background:#ff5a5a;box-shadow:0 0 0 0 rgba(255,90,90,.7);animation:wgrPulse 1.6s infinite;flex:none}
  @keyframes wgrPulse{0%{box-shadow:0 0 0 0 rgba(255,90,90,.6)}70%{box-shadow:0 0 0 8px rgba(255,90,90,0)}100%{box-shadow:0 0 0 0 rgba(255,90,90,0)}}
  #wgr-{{ section.id }} .wgr__title{position:relative;margin:0 0 14px;font-size:18px;font-weight:800;color:#fff;line-height:1.3}
  #wgr-{{ section.id }} .wgr__title span{color:#2ee06f}
  #wgr-{{ section.id }} .wgr__list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;position:relative}
  #wgr-{{ section.id }} .wgr__list li{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:11px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:10px 12px}
  #wgr-{{ section.id }} .wgr__ico{font-size:22px;line-height:1;flex:none}
  #wgr-{{ section.id }} .wgr__name{font-size:14px;font-weight:600;color:#eaf1ff;min-width:0}
  #wgr-{{ section.id }} .wgr__val{font-size:11.5px;font-weight:800;color:#2ee06f;background:rgba(46,224,111,.14);border:1px solid rgba(46,224,111,.3);padding:3px 10px;border-radius:999px;white-space:nowrap}
  #wgr-{{ section.id }} .wgr__note{position:relative;margin:13px 0 0;font-size:12px;font-weight:600;color:#ffdcdc;text-align:center;background:rgba(255,90,90,.12);border:1px solid rgba(255,90,90,.28);border-radius:10px;padding:9px 11px;line-height:1.5}
{%- endstyle -%}

{% schema %}
{
  "name": "Baner • 2 gratisy",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł (pulsująca kropka)", "default": "TYLKO DZIŚ" },
    { "type": "text", "id": "title_before", "label": "Tytuł (biała część)", "default": "Do zamówienia otrzymujesz" },
    { "type": "text", "id": "title_accent", "label": "Tytuł (zielona część)", "default": "2 gratisy!" },
    { "type": "header", "content": "Gratis 1" },
    { "type": "text", "id": "g1_icon", "label": "Emoji", "default": "🕸️" },
    { "type": "text", "id": "g1_title", "label": "Nazwa", "default": "Sztuczna pajęczyna XXL" },
    { "type": "text", "id": "g1_value", "label": "Etykieta / wartość", "default": "GRATIS" },
    { "type": "header", "content": "Gratis 2" },
    { "type": "text", "id": "g2_icon", "label": "Emoji", "default": "🦇" },
    { "type": "text", "id": "g2_title", "label": "Nazwa", "default": "Naklejki Halloween (10 szt.)" },
    { "type": "text", "id": "g2_value", "label": "Etykieta / wartość", "default": "GRATIS" },
    { "type": "header", "content": "Dopisek i wygląd" },
    { "type": "textarea", "id": "note", "label": "Dopisek pod gratisami (czerwony)", "default": "Gratisy dodajemy automatycznie do Twojego zamówienia — tylko dziś." },
    { "type": "range", "id": "max_width", "label": "Maks. szerokość", "min": 360, "max": 920, "step": 20, "default": 640, "unit": "px" },
    { "type": "range", "id": "pad_top", "label": "Odstęp od góry", "min": 0, "max": 80, "step": 4, "default": 8, "unit": "px" },
    { "type": "range", "id": "pad_bottom", "label": "Odstęp od dołu", "min": 0, "max": 80, "step": 4, "default": 8, "unit": "px" }
  ],
  "presets": [ { "name": "Baner • 2 gratisy" } ]
}
{% endschema %}
