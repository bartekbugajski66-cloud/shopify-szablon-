{%- comment -%} Miotła Halloween — Gwarancja (granatowa karta, styl THEVIREA) {%- endcomment -%}
<section class="drip-gua drip-sec" id="drip-gua-{{ section.id }}">
  <div class="drip-container">
    <div class="drip-gua__card">
      <div class="drip-gua__badge">
        <strong>{{ section.settings.badge_big }}</strong>
        <span>{{ section.settings.badge_small }}</span>
      </div>
      <div class="drip-gua__body">
        {%- if section.settings.eyebrow != blank -%}<span class="drip-gua__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="drip-gua__title">{{ section.settings.heading }}</h2>
        <p class="drip-gua__text">{{ section.settings.text }}</p>
      </div>
    </div>
  </div>
</section>
{%- style -%}
  #drip-gua-{{ section.id }} .drip-gua__card{background:var(--drip-blue);color:#fff;border-radius:22px;padding:28px 22px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px}
  #drip-gua-{{ section.id }} .drip-gua__badge{flex:none;width:96px;height:96px;border-radius:50%;border:2px solid rgba(255,255,255,.5);display:grid;place-content:center;line-height:1.1}
  #drip-gua-{{ section.id }} .drip-gua__badge strong{font-size:30px;font-weight:800}
  #drip-gua-{{ section.id }} .drip-gua__badge span{font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.85}
  #drip-gua-{{ section.id }} .drip-gua__eyebrow{display:inline-block;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;opacity:.85;margin-bottom:8px}
  #drip-gua-{{ section.id }} .drip-gua__title{font-size:clamp(20px,4.5vw,28px);font-weight:800;line-height:1.25;margin:0 0 10px}
  #drip-gua-{{ section.id }} .drip-gua__text{margin:0;font-size:14.5px;opacity:.9;line-height:1.6;max-width:620px}
  #drip-gua-{{ section.id }} .drip-gua__text a{color:#fff;font-weight:700}
  @media(min-width:900px){#drip-gua-{{ section.id }} .drip-gua__card{flex-direction:row;text-align:left;padding:40px 48px;gap:40px}#drip-gua-{{ section.id }} .drip-gua__body{flex:1}}
{%- endstyle -%}
{% schema %}
{
  "name": "Miotła Halloween • Gwarancja",
  "settings": [
    { "type":"text","id":"badge_big","label":"Odznaka — duża","default":"30" },
    { "type":"text","id":"badge_small","label":"Odznaka — mała","default":"DNI TESTÓW" },
    { "type":"text","id":"eyebrow","label":"Nadtytuł","default":"TWOJE BEZPIECZEŃSTWO" },
    { "type":"text","id":"heading","label":"Nagłówek","default":"Wypróbuj Miotłę Halloween przez 30 dni. Jeśli nie zachwyci Twoich gości — oddajemy 100% wpłaconych środków." },
    { "type":"richtext","id":"text","label":"Tekst","default":"<p>Wystarczy napisać na kontakt@twojadomena.pl — zapewniamy prosty proces i wygodny zwrot kodem do Paczkomatu. Zwrot środków zlecamy natychmiast po otrzymaniu przesyłki. To nasza obietnica.</p>" }
  ],
  "presets": [ { "name":"Miotła Halloween • Gwarancja" } ]
}
{% endschema %}
