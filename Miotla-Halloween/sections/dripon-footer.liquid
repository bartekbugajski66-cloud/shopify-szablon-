{%- comment -%} Miotła Halloween — Footer (styl THEVIREA) {%- endcomment -%}
<footer class="drip-footer" id="drip-footer-{{ section.id }}">
  <div class="drip-container drip-footer__inner">
    <div class="drip-footer__col drip-footer__brand">
      <span class="drip-footer__logo">● {{ section.settings.brand_name }}</span>
      <p class="drip-footer__desc">{{ section.settings.brand_text }}</p>
      {%- if section.settings.badge_text != blank -%}<span class="drip-footer__badge">🛡️ {{ section.settings.badge_text }}</span>{%- endif -%}
    </div>

    <div class="drip-footer__col">
      <h3 class="drip-footer__head">{{ section.settings.col1_title }}</h3>
      <nav class="drip-footer__links">{%- for link in section.settings.menu1.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</nav>
    </div>

    <div class="drip-footer__col">
      <h3 class="drip-footer__head">{{ section.settings.col2_title }}</h3>
      <nav class="drip-footer__links">{%- for link in section.settings.menu2.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</nav>
    </div>

    <div class="drip-footer__col">
      <h3 class="drip-footer__head">{{ section.settings.contact_title }}</h3>
      {%- if section.settings.email != blank -%}<a class="drip-footer__line" href="mailto:{{ section.settings.email }}">✉️ {{ section.settings.email }}</a>{%- endif -%}
      {%- if section.settings.hours != blank -%}<span class="drip-footer__line">🕒 {{ section.settings.hours }}</span>{%- endif -%}
      <h3 class="drip-footer__head drip-footer__head--pay">Płatności</h3>
      <div class="drip-footer__pays">
        {%- assign pays = section.settings.payments | split: ',' -%}
        {%- for p in pays -%}<span class="drip-footer__pay">{{ p | strip }}</span>{%- endfor -%}
      </div>
    </div>
  </div>
  <div class="drip-footer__bottom"><div class="drip-container">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name }}. Wszelkie prawa zastrzeżone.</div></div>
</footer>
{%- style -%}
  #drip-footer-{{ section.id }}{background:#0c1315;color:#fff}
  #drip-footer-{{ section.id }} .drip-footer__inner{display:grid;grid-template-columns:1fr;gap:30px;padding-top:46px;padding-bottom:34px}
  #drip-footer-{{ section.id }} .drip-footer__logo{font-size:20px;font-weight:800;color:#fff}
  #drip-footer-{{ section.id }} .drip-footer__desc{font-size:13.5px;line-height:1.6;color:#9fb0ca;margin:12px 0 16px;max-width:340px}
  #drip-footer-{{ section.id }} .drip-footer__badge{display:inline-block;border:1px solid rgba(255,255,255,.18);border-radius:10px;padding:8px 14px;font-size:12.5px;font-weight:700}
  #drip-footer-{{ section.id }} .drip-footer__head{font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#7e90ad;margin:0 0 14px}
  #drip-footer-{{ section.id }} .drip-footer__head--pay{margin-top:22px}
  #drip-footer-{{ section.id }} .drip-footer__links{display:flex;flex-direction:column;gap:10px}
  #drip-footer-{{ section.id }} .drip-footer__links a,#drip-footer-{{ section.id }} .drip-footer__line{color:#cdd8ea;text-decoration:none;font-size:14px;display:block;margin-bottom:8px}
  #drip-footer-{{ section.id }} .drip-footer__links a:hover{color:#fff;text-decoration:underline}
  #drip-footer-{{ section.id }} .drip-footer__pays{display:flex;flex-wrap:wrap;gap:8px}
  #drip-footer-{{ section.id }} .drip-footer__pay{background:#fff;color:#0c1315;font-size:11px;font-weight:800;padding:6px 10px;border-radius:6px}
  #drip-footer-{{ section.id }} .drip-footer__bottom{border-top:1px solid rgba(255,255,255,.1);padding:18px 0;font-size:12.5px;color:#7e90ad;text-align:center}
  @media(min-width:900px){#drip-footer-{{ section.id }} .drip-footer__inner{grid-template-columns:1.6fr 1fr 1fr 1.3fr;gap:40px;padding-top:60px}}
{%- endstyle -%}
{% schema %}
{
  "name": "Miotła Halloween • Footer",
  "settings": [
    { "type":"text","id":"brand_name","label":"Marka","default":"MIOTŁA HALLOWEEN" },
    { "type":"textarea","id":"brand_text","label":"Opis","default":"Świecące, animowane dekoracje na Halloween. Łączymy efekt światła, dźwięku i ruchu, by Twój dom naprawdę przyciągał uwagę." },
    { "type":"text","id":"badge_text","label":"Odznaka","default":"30 Dni Gwarancji Satysfakcji" },
    { "type":"text","id":"col1_title","label":"Kolumna 1 — tytuł","default":"Informacje" },
    { "type":"link_list","id":"menu1","label":"Kolumna 1 — menu","default":"footer" },
    { "type":"text","id":"col2_title","label":"Kolumna 2 — tytuł","default":"Pomoc" },
    { "type":"link_list","id":"menu2","label":"Kolumna 2 — menu" },
    { "type":"text","id":"contact_title","label":"Kontakt — tytuł","default":"Kontakt" },
    { "type":"text","id":"email","label":"E-mail","default":"kontakt@twojadomena.pl" },
    { "type":"text","id":"hours","label":"Godziny","default":"Pn-Pt: 8:00 - 16:00" },
    { "type":"text","id":"payments","label":"Płatności (po przecinku)","default":"BLIK, Przelew, VISA, MasterCard, ApplePay" }
  ]
}
{% endschema %}
