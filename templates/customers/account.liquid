<div class="drip-page page-width">
  <h1>Moje konto</h1>
  <p>Witaj{% if customer.first_name %}, {{ customer.first_name }}{% endif %}! · <a href="{{ routes.account_logout_url }}">Wyloguj</a></p>
  <p><a href="{{ routes.account_addresses_url }}">Moje adresy ({{ customer.addresses_count }})</a></p>

  <h2 style="font-size:20px; font-weight:800; margin-top:28px;">Zamówienia</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size == 0 -%}
      <p>Nie masz jeszcze zamówień.</p>
    {%- else -%}
      <table class="drip-cart-table">
        <thead><tr><th>Zamówienie</th><th>Data</th><th>Status płatności</th><th>Suma</th></tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%d.%m.%Y' }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}
  {%- endpaginate -%}
</div>
