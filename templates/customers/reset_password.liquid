<div class="drip-page page-width" style="max-width:480px;">
  <h1>Nowe hasło</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label class="drip-label" for="ResetPassword">Hasło</label>
    <input class="drip-input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    <label class="drip-label" for="ResetPasswordConfirm">Powtórz hasło</label>
    <input class="drip-input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    <button type="submit" class="drip-btn" style="margin-top:16px; width:100%;">Zmień hasło</button>
  {%- endform -%}
</div>
