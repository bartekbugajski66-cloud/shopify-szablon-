<div class="drip-page page-width">
  <h1>Wyszukiwanie</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex; gap:10px; max-width:520px; margin-bottom:24px;">
    <input class="drip-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Czego szukasz?" aria-label="Szukaj">
    <button type="submit" class="drip-btn">Szukaj</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p>Wyniki dla „{{ search.terms | escape }}": {{ search.results_count }}</p>
      <div class="drip-grid-products" style="margin-top:14px;">
        {%- for item in search.results -%}
          <a href="{{ item.url }}" class="drip-card">
            {%- if item.featured_image -%}
              {{ item.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'drip-card__img', alt: item.title | escape }}
            {%- elsif item.image -%}
              {{ item.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'drip-card__img', alt: item.title | escape }}
            {%- else -%}
              <div class="drip-card__placeholder"></div>
            {%- endif -%}
            <div class="drip-card__title">{{ item.title }}</div>
            {%- if item.price -%}<div class="drip-card__price">{{ item.price | money }}</div>{%- endif -%}
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="drip-pagination" aria-label="Paginacja">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>
