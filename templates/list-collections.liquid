<div class="drip-page page-width">
  <h1>Kolekcje</h1>
  <div class="drip-grid-products" style="margin-top:20px;">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="drip-card">
        {%- if collection.featured_image -%}
          {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'drip-card__img', alt: collection.title | escape }}
        {%- else -%}
          <div class="drip-card__placeholder"></div>
        {%- endif -%}
        <div class="drip-card__title">{{ collection.title }}</div>
      </a>
    {%- endfor -%}
  </div>
</div>
