<div class="drip-page page-width" style="max-width:480px; text-align:center; padding-top:80px;">
  <h1>{{ shop.name }}</h1>
  <p>Sklep wkrótce się otworzy.</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label class="drip-label" for="Password">Hasło</label>
    <input class="drip-input" type="password" name="password" id="Password">
    <button type="submit" class="drip-btn" style="margin-top:14px; width:100%;">Wejdź</button>
  {%- endform -%}
</div>
