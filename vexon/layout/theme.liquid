<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#050B1F">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'vexon-mark.svg' | asset_url }}">
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if page_image -%}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Unbounded:wght@700;800;900&display=swap" rel="stylesheet">
  {{ 'vexon.css' | asset_url | stylesheet_tag }}
  <script>
    window.VX = {
      routes: { cart: {{ routes.cart_url | json }}, cartAdd: {{ routes.cart_add_url | append: '.js' | json }}, cartChange: {{ routes.cart_change_url | append: '.js' | json }}, root: {{ routes.root_url | json }} },
      money: {{ shop.money_format | json }},
      cartType: {{ settings.cart_type | default: 'drawer' | json }}
    };
  </script>
  <script src="{{ 'vexon.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="tpl-{{ template.name }}">
  <a class="vx-visually-hidden" href="#MainContent">Przejdź do treści</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'cart-drawer' %}
</body>
</html>
