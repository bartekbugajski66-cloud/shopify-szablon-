    "faq": {
      "type": "vx-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "Po jakich powierzchniach jeździ?",
            "a": "<p>Po gładkich i płaskich: gładka ściana, szyba, lustro, szafa, płaski sufit i oczywiście podłoga. Nie utrzyma się na tynku z fakturą, tapecie z wzorem ani nierównych powierzchniach.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Jak przełączyć na jazdę po ścianie?",
            "a": "<p>Z tyłu auta jest przełącznik WALL / FLOOR. Ustaw WALL, przyłóż auto do ściany i dopiero wtedy ruszaj pilotem.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Ile jeździ na jednym ładowaniu?",
            "a": "<p>Około 8 minut. Auto ładujesz przez dołączony kabel USB — z ładowarki, komputera lub powerbanku. Podczas ładowania przełącznik w aucie ustaw na OFF.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Czy zostawia ślady na ścianie?",
            "a": "<p>Auto trzyma się dzięki zasysaniu powietrza, bez kleju. Na bardzo jasnych ścianach dobrze najpierw sprawdzić w mało widocznym miejscu.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Do czego jest biała osłonka pod autem?",
            "a": "<p>To część systemu przyssania. Nie odrywaj jej — przed jazdą po ścianie upewnij się tylko, że leży płasko.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "Czy baterie są w zestawie?",
            "a": "<p>Auto ma wbudowany akumulator ładowany przez USB. Do pilota potrzebne są baterie, których nie ma w zestawie.</p>"
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "Dla kogo jest ta zabawka?",
            "a": "<p>Producent zaleca wiek 14+. Młodsze dzieci powinny bawić się pod nadzorem dorosłych.</p>"
          }
        },
        "q8": {
          "type": "qa",
          "settings": {
            "q": "Ile kosztuje dostawa i jak zwrócić?",
            "a": "<p>Dostawa jest zawsze darmowa. Masz 30 dni od odbioru na zwrot — szczegóły na stronie <a href=\"/pages/zwroty\">Zwroty</a>.</p>"
          }
        }
      },
