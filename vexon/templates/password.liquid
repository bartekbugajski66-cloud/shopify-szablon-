<div class="vx-page " style="max-width:480px; text-align:center; padding-top:80px;">
  <h1>{{ shop.name }}</h1>
  <p>Sklep wkrótce się otworzy.</p>
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label class="vx-label" for="Password">Hasło</label>
    <input class="vx-input" type="password" name="password" id="Password">
    <button type="submit" class="vx-btn" style="margin-top:14px; width:100%;">Wejdź</button>
  {%- endform -%}
</div>
