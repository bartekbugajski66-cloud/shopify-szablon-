<div class="vx-page " style="max-width:480px;">
  <h1>Nowe hasło</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label class="vx-label" for="ResetPassword">Hasło</label>
    <input class="vx-input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    <label class="vx-label" for="ResetPasswordConfirm">Powtórz hasło</label>
    <input class="vx-input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    <button type="submit" class="vx-btn" style="margin-top:16px; width:100%;">Zmień hasło</button>
  {%- endform -%}
</div>
