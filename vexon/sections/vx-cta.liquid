<section class="vx-section">
  <div class="vx-wrap">
    <div class="vx-cta" data-reveal>
      <div class="vx-cta__car">{% render 'vexon-car', id: 'cta' %}</div>
      <div class="vx-cta__badge"><div><b>{{ section.settings.days }}</b><small>DNI NA<br>ZWROT</small></div></div>
      <h2 class="vx-h2">{{ section.settings.heading }} <span class="vx-grad">{{ section.settings.heading_accent }}</span></h2>
      <p class="vx-lead">{{ section.settings.text }}</p>
      <a href="#vx-buy" class="vx-btn vx-btn--xl" data-vx-scroll-buy>{{ section.settings.cta }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "VEXON • Gwarancja + CTA",
  "settings": [
    { "type": "text", "id": "days", "label": "Liczba dni", "default": "30" },
    { "type": "text", "id": "heading", "label": "Tytuł", "default": "Sprawdź bez ryzyka." },
    { "type": "text", "id": "heading_accent", "label": "Tytuł (wyróżnienie)", "default": "30 dni na zwrot." },
    { "type": "textarea", "id": "text", "label": "Opis", "default": "Jeśli auto nie spełni Twoich oczekiwań, odeślij je w ciągu 30 dni od odbioru, a oddamy pieniądze. Dostawa do Ciebie jest zawsze darmowa." },
    { "type": "text", "id": "cta", "label": "Przycisk", "default": "Wybieram swój VEXON ⚡" }
  ],
  "presets": [ { "name": "VEXON • Gwarancja + CTA" } ]
}
{% endschema %}
