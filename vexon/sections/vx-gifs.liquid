<section class="vx-section" id="vx-gifs">
  <div class="vx-wrap">
    <div class="vx-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-h2">{{ section.settings.heading }} <span class="vx-grad">{{ section.settings.heading_accent }}</span></h2>
      {%- if section.settings.text != blank -%}<p class="vx-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="vx-gifs__grid">
      {%- for block in section.blocks -%}
        <div class="vx-gif" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
          {%- if block.settings.video_asset != blank -%}
            <video src="{{ block.settings.video_asset | asset_url }}" autoplay loop muted playsinline preload="metadata" aria-label="{{ block.settings.caption | escape }}"></video>
          {%- elsif block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata' }}
          {%- elsif block.settings.video_url != blank -%}
            <video src="{{ block.settings.video_url }}" autoplay loop muted playsinline preload="metadata"></video>
          {%- elsif block.settings.image != blank -%}
            {%- if block.settings.image.src contains '.gif' -%}
              <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- else -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.caption }}
            {%- endif -%}
          {%- else -%}
            <div class="vx-gif__ph">
              <span class="vx-gif__play"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              <span>Miejsce na GIF / film {{ forloop.index }}</span>
              <small>Dodasz go w: Dostosuj → ta sekcja</small>
            </div>
          {%- endif -%}
          <span class="vx-gif__num">0{{ forloop.index }}</span>
          {%- if block.settings.caption != blank -%}<div class="vx-gif__cap">{{ block.settings.caption }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "VEXON • GIF-y / filmy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "W akcji" },
    { "type": "text", "id": "heading", "label": "Tytuł", "default": "Zobacz, jak" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł (wyróżnienie)", "default": "wjeżdża na ścianę" },
    { "type": "textarea", "id": "text", "label": "Opis" }
  ],
  "blocks": [
    { "type": "gif", "name": "GIF / film", "settings": [
      { "type": "video", "id": "video", "label": "Film (MP4, najlepiej pionowy)" },
      { "type": "text", "id": "video_asset", "label": "…albo plik MP4 z motywu (assets)", "info": "Nazwa pliku z folderu assets, np. vexon-film-1.mp4" },
      { "type": "url", "id": "video_url", "label": "…albo link do pliku MP4" },
      { "type": "image_picker", "id": "image", "label": "…albo GIF / zdjęcie" },
      { "type": "text", "id": "caption", "label": "Podpis", "default": "Jazda po ścianie" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "VEXON • GIF-y / filmy", "blocks": [ { "type": "gif" }, { "type": "gif" }, { "type": "gif" } ] } ]
}
{% endschema %}
