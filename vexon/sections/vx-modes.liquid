{%- liquid
  assign first_mode = section.blocks.first.settings.mode | default: 'wall'
  assign fb = section.blocks.first.settings
  assign first_media = false
  if fb.video != blank or fb.video_url != blank or fb.image != blank
    assign first_media = true
  endif
-%}
<section class="vx-section" id="vx-modes" data-vx-modes>
  <div class="vx-wrap">
    <div class="vx-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-h2">{{ section.settings.heading }} <span class="vx-grad">{{ section.settings.heading_accent }}</span></h2>
      {%- if section.settings.text != blank -%}<p class="vx-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="vx-modes__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" class="vx-tab{% if forloop.first %} is-active{% endif %}" data-vx-mode="{{ block.settings.mode }}" aria-selected="{{ forloop.first }}" {{ block.shopify_attributes }}>{{ block.settings.icon }} {{ block.settings.tab }}</button>
      {%- endfor -%}
    </div>
    <div class="vx-modes__grid">
      <div class="vx-stage{% if first_media %} has-media{% endif %}" data-mode="{{ first_mode }}" data-vx-stage data-reveal>
        <div class="vx-stage__room">
          <div class="vx-stage__ceil"></div>
          <div class="vx-stage__glass">{%- for i in (1..9) -%}<i style="left:{{ i | times: 11 }}%;height:{{ i | modulo: 3 | plus: 2 | times: 6 }}px;animation-delay:-{{ i | times: 0.37 }}s"></i>{%- endfor -%}</div>
          <div class="vx-stage__floor"></div>
        </div>
        <div class="vx-stage__hud"><span class="vx-pill vx-pill--hot" data-vx-mode-hud>{{ section.blocks.first.settings.tab }}</span></div>
        <div class="vx-stage__car">{% render 'vexon-car', id: 'stage' %}</div>
        {%- for block in section.blocks -%}
          {%- if block.settings.video != blank or block.settings.video_url != blank or block.settings.image != blank -%}
            <div class="vx-stage__media{% if forloop.first %} is-active{% endif %}" data-mode-media="{{ forloop.index0 }}">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: forloop.first, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata' }}
              {%- elsif block.settings.video_url != blank -%}
                <video src="{{ block.settings.video_url }}" {% if forloop.first %}autoplay{% endif %} loop muted playsinline preload="metadata"></video>
              {%- elsif block.settings.image.src contains '.gif' -%}
                <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
              {%- else -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 700px, 100vw', alt: block.settings.title }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="vx-mode-copy">
        {%- for block in section.blocks -%}
          <div data-mode-pane="{{ block.settings.mode }}" class="{% if forloop.first %}is-active{% endif %}">
            <h3>{{ block.settings.icon }} {{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
        <div class="vx-mode-progress" data-vx-mode-progress><i></i></div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "VEXON • Tryby jazdy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "Kliknij i zobacz" },
    { "type": "text", "id": "heading", "label": "Tytuł", "default": "Grawitacja?" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł (wyróżnienie)", "default": "Nie tym razem." },
    { "type": "textarea", "id": "text", "label": "Opis", "default": "Jedno auto, pięć sposobów na zabawę. Przełącznik z tyłu auta zmienia tryb: podłoga albo ściana." }
  ],
  "blocks": [
    { "type": "mode", "name": "Tryb", "settings": [
      { "type": "select", "id": "mode", "label": "Animacja", "options": [ { "value": "floor", "label": "Podłoga" }, { "value": "wall", "label": "Ściana" }, { "value": "ceiling", "label": "Sufit" }, { "value": "glass", "label": "Szyba" }, { "value": "stunt", "label": "Obrót 360°" } ], "default": "wall" },
      { "type": "text", "id": "icon", "label": "Emoji", "default": "🧱" },
      { "type": "text", "id": "tab", "label": "Nazwa zakładki", "default": "Ściana" },
      { "type": "text", "id": "title", "label": "Tytuł", "default": "Jazda po ścianie" },
      { "type": "textarea", "id": "text", "label": "Opis" },
      { "type": "header", "content": "Twoje zdjęcie / film (zamiast animacji)" },
      { "type": "image_picker", "id": "image", "label": "Zdjęcie lub GIF" },
      { "type": "video", "id": "video", "label": "Film (MP4)" },
      { "type": "url", "id": "video_url", "label": "…albo link do MP4" }
    ] }
  ],
  "max_blocks": 5,
  "presets": [ { "name": "VEXON • Tryby jazdy" } ]
}
{% endschema %}
