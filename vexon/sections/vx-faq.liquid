<section class="vx-section" id="vx-faq">
  <div class="vx-wrap">
    <div class="vx-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-h2">{{ section.settings.heading }} <span class="vx-grad">{{ section.settings.heading_accent }}</span></h2>
    </div>
    <div class="vx-faq" data-reveal>
      {%- for block in section.blocks -%}
        <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.q }}</summary>
          <div class="vx-faq__a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "VEXON • FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Tytuł", "default": "Pytania" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł (wyróżnienie)", "default": "i odpowiedzi" }
  ],
  "blocks": [
    { "type": "qa", "name": "Pytanie", "settings": [
      { "type": "text", "id": "q", "label": "Pytanie", "default": "Pytanie?" },
      { "type": "richtext", "id": "a", "label": "Odpowiedź", "default": "<p>Odpowiedź.</p>" }
    ] }
  ],
  "presets": [ { "name": "VEXON • FAQ" } ]
}
{% endschema %}
