<section class="vx-section">
  <div class="vx-wrap">
    <div class="vx-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-h2">{{ section.settings.heading }} <span class="vx-grad">{{ section.settings.heading_accent }}</span></h2>
    </div>
    <div class="vx-compare" data-reveal>
      <div class="vx-compare__row"><div></div><div>{{ section.settings.them }}</div><div class="vx-compare__us">{{ section.settings.us }}</div></div>
      {%- for block in section.blocks -%}
        <div class="vx-compare__row" {{ block.shopify_attributes }}>
          <div>{{ block.settings.feature }}</div>
          <div>{% if block.settings.them %}<span class="vx-yes">✓</span>{% else %}<span class="vx-no">✕</span>{% endif %}</div>
          <div class="vx-compare__us">{% if block.settings.us %}<span class="vx-yes">✓</span>{% else %}<span class="vx-no">✕</span>{% endif %}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "VEXON • Porównanie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "Porównanie" },
    { "type": "text", "id": "heading", "label": "Tytuł", "default": "Zwykłe autko RC" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł (wyróżnienie)", "default": "vs VEXON" },
    { "type": "text", "id": "them", "label": "Kolumna 1", "default": "Zwykłe RC" },
    { "type": "text", "id": "us", "label": "Kolumna 2", "default": "VEXON" }
  ],
  "blocks": [
    { "type": "row", "name": "Wiersz", "settings": [
      { "type": "text", "id": "feature", "label": "Cecha", "default": "Jazda po ścianach" },
      { "type": "checkbox", "id": "them", "label": "Zwykłe RC ma", "default": false },
      { "type": "checkbox", "id": "us", "label": "VEXON ma", "default": true }
    ] }
  ],
  "presets": [ { "name": "VEXON • Porównanie" } ]
}
{% endschema %}
