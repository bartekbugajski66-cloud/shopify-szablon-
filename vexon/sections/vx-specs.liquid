<section class="vx-section">
  <div class="vx-wrap">
    <div class="vx-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="vx-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="vx-h2">{{ section.settings.heading }} <span class="vx-grad">{{ section.settings.heading_accent }}</span></h2>
    </div>
    <div class="vx-specs">
      <div class="vx-card" data-reveal>
        <h3>{{ section.settings.box_title }}</h3>
        <div class="vx-box">
          {%- for block in section.blocks -%}
            {%- if block.type == 'item' -%}
              <div class="vx-box__i" {{ block.shopify_attributes }}><span>{{ block.settings.icon }}</span>{{ block.settings.title }}{% if block.settings.note != blank %}<small>{{ block.settings.note }}</small>{% endif %}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="vx-card" data-reveal data-reveal-delay="2">
        <h3>{{ section.settings.spec_title }}</h3>
        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' -%}
            <div class="vx-spec" {{ block.shopify_attributes }}><span>{{ block.settings.key }}</span><b>{{ block.settings.value }}</b></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "VEXON • Zestaw i dane",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "Bez niespodzianek" },
    { "type": "text", "id": "heading", "label": "Tytuł", "default": "Co jest" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł (wyróżnienie)", "default": "w pudełku" },
    { "type": "text", "id": "box_title", "label": "Tytuł zestawu", "default": "📦 W zestawie" },
    { "type": "text", "id": "spec_title", "label": "Tytuł danych", "default": "⚙️ Dane techniczne" }
  ],
  "blocks": [
    { "type": "item", "name": "Element zestawu", "settings": [
      { "type": "text", "id": "icon", "label": "Emoji", "default": "🏎️" },
      { "type": "text", "id": "title", "label": "Nazwa", "default": "Auto" },
      { "type": "text", "id": "note", "label": "Notka" }
    ] },
    { "type": "spec", "name": "Parametr", "settings": [
      { "type": "text", "id": "key", "label": "Nazwa", "default": "Skala" },
      { "type": "text", "id": "value", "label": "Wartość", "default": "1:18" }
    ] }
  ],
  "presets": [ { "name": "VEXON • Zestaw i dane" } ]
}
{% endschema %}
