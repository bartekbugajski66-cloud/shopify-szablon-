{%- comment -%} LASERIX — jak to działa (3 kroki) {%- endcomment -%}
<section class="lx-sec lx-sec--{{ section.settings.bg }}">
  <div class="lx-container">
    {%- render 'lx-head', s: section.settings -%}
    <div class="lx-steps">
      {%- for block in section.blocks -%}
        <div class="lx-step" {{ block.shopify_attributes }}>
          <span class="lx-step__num">{{ forloop.index }}</span>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: class: 'lx-step__img', loading: 'lazy', sizes: '(min-width: 800px) 33vw, 100vw' }}
          {%- elsif block.settings.asset != blank -%}
            <img class="lx-step__img" src="{{ block.settings.asset | asset_url }}" alt="" loading="lazy" width="600" height="450">
          {%- else -%}
            <div class="lx-step__ico" aria-hidden="true">{{ block.settings.icon }}</div>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Laserix — jak to działa",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — neonowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Panel (ciemny granat)" }, { "value": "pink", "label": "Czerwona poświata" }, { "value": "lilac", "label": "Fioletowa poświata" },
      { "value": "mint", "label": "Zielona poświata" }, { "value": "sky", "label": "Niebieska poświata" }, { "value": "sun", "label": "Żółta poświata" }, { "value": "none", "label": "Brak" } ]}
  ],
  "blocks": [
    { "type": "step", "name": "Krok", "settings": [
      { "type": "image_picker", "id": "image", "label": "Zdjęcie (opcjonalnie)" },
      { "type": "text", "id": "asset", "label": "Albo plik z Zasobów motywu (opcjonalnie)" },
      { "type": "text", "id": "icon", "label": "Emotka (gdy brak zdjęcia)", "default": "🎯" },
      { "type": "text", "id": "title", "label": "Tytuł", "default": "Krok" },
      { "type": "textarea", "id": "text", "label": "Tekst" }
    ]}
  ],
  "presets": [{ "name": "Laserix — jak to działa" }]
}
{% endschema %}
