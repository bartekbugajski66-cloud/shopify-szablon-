{%- comment -%} LASERIX — gwarancja {%- endcomment -%}
<section class="lx-sec lx-sec--{{ section.settings.bg }}">
  <div class="lx-container">
    <div class="lx-guar">
      <div class="lx-guar__seal" aria-hidden="true"><div class="lx-guar__seal-in"><div><b>{{ section.settings.days }}</b><small>{{ section.settings.seal_text }}</small></div></div></div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="lx-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="lx-h2">{{ section.settings.heading }} <span class="lx-rainbow-text">{{ section.settings.heading_accent }}</span></h2>
        <p class="lx-lead" style="margin-bottom:0">{{ section.settings.subheading }}</p>
        {%- assign pts = section.settings.points | split: ',' -%}
        <ul class="lx-guar__points">{%- for p in pts -%}<li>{{ p | strip }}</li>{%- endfor -%}</ul>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Laserix — gwarancja",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — neonowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Panel (ciemny granat)" }, { "value": "pink", "label": "Czerwona poświata" }, { "value": "lilac", "label": "Fioletowa poświata" },
      { "value": "mint", "label": "Zielona poświata" }, { "value": "sky", "label": "Niebieska poświata" }, { "value": "sun", "label": "Żółta poświata" }, { "value": "none", "label": "Brak" } ]},
    { "type": "text", "id": "days", "label": "Liczba dni", "default": "30" },
    { "type": "text", "id": "seal_text", "label": "Napis na pieczęci", "default": "dni na zwrot" },
    { "type": "text", "id": "points", "label": "Punkty (po przecinku)", "default": "🛡️ 30 dni gwarancji, 🚀 Szybka wysyłka, 🔒 Bezpieczne płatności, 💌 Pomocna obsługa" }
  ],
  "presets": [{ "name": "Laserix — gwarancja" }]
}
{% endschema %}
