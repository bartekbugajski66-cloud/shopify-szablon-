{%- comment -%} LASERIX — porównanie (zwykły sposób vs Laserix) {%- endcomment -%}
<section class="lx-sec lx-sec--{{ section.settings.bg }}">
  <div class="lx-container">
    {%- render 'lx-head', s: section.settings -%}
    <div class="lx-cmp">
      <div class="lx-cmp__col lx-cmp__col--bad">
        {%- if section.settings.left_image != blank -%}
          {{ section.settings.left_image | image_url: width: 700 | image_tag: class: 'lx-cmp__img', loading: 'lazy', sizes: '(min-width: 800px) 45vw, 100vw' }}
        {%- else -%}<div class="lx-cmp__emoji" aria-hidden="true">{{ section.settings.left_emoji }}</div>{%- endif -%}
        <h3>{{ section.settings.left_title }}</h3>
        <ul>{%- for block in section.blocks -%}{%- if block.type == 'left' -%}<li {{ block.shopify_attributes }}><span aria-hidden="true">✖</span>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}</ul>
      </div>
      <span class="lx-cmp__vs" aria-hidden="true">VS</span>
      <div class="lx-cmp__col lx-cmp__col--good">
        {%- if section.settings.right_image != blank -%}
          {{ section.settings.right_image | image_url: width: 700 | image_tag: class: 'lx-cmp__img', loading: 'lazy', sizes: '(min-width: 800px) 45vw, 100vw' }}
        {%- else -%}<div class="lx-cmp__emoji" aria-hidden="true">{{ section.settings.right_emoji }}</div>{%- endif -%}
        <h3>{{ section.settings.right_title }}</h3>
        <ul>{%- for block in section.blocks -%}{%- if block.type == 'right' -%}<li {{ block.shopify_attributes }}><span aria-hidden="true">✔</span>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}</ul>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Laserix — porównanie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — neonowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Panel (ciemny granat)" }, { "value": "pink", "label": "Czerwona poświata" }, { "value": "lilac", "label": "Fioletowa poświata" },
      { "value": "mint", "label": "Zielona poświata" }, { "value": "sky", "label": "Niebieska poświata" }, { "value": "sun", "label": "Żółta poświata" }, { "value": "none", "label": "Brak" } ]},
    { "type": "text", "id": "left_title", "label": "Lewa — tytuł", "default": "Kolejna gra na tablecie" },
    { "type": "text", "id": "left_emoji", "label": "Lewa — emotka (gdy brak zdjęcia)", "default": "😖" },
    { "type": "image_picker", "id": "left_image", "label": "Lewa — zdjęcie" },
    { "type": "text", "id": "right_title", "label": "Prawa — tytuł", "default": "Laserix" },
    { "type": "text", "id": "right_emoji", "label": "Prawa — emotka (gdy brak zdjęcia)", "default": "🤩" },
    { "type": "image_picker", "id": "right_image", "label": "Prawa — zdjęcie" }
  ],
  "blocks": [
    { "type": "left", "name": "Wada (lewa)", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Wada" } ] },
    { "type": "right", "name": "Zaleta (prawa)", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Zaleta" } ] }
  ],
  "presets": [{ "name": "Laserix — porównanie" }]
}
{% endschema %}
