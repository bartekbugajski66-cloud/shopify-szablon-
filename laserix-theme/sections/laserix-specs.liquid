{%- comment -%} LASERIX — specyfikacja ze zdjęciem {%- endcomment -%}
<section class="lx-sec lx-sec--{{ section.settings.bg }}">
  <div class="lx-container">
    {%- render 'lx-head', s: section.settings -%}
    <div class="lx-specs{% if section.settings.image == blank and section.settings.asset == blank %} lx-specs--noimg{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="lx-specs__img">{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 45vw, 100vw' }}</div>
      {%- elsif section.settings.asset != blank -%}
        <div class="lx-specs__img"><img src="{{ section.settings.asset | asset_url }}" alt="" loading="lazy" width="800" height="860"></div>
      {%- endif -%}
      <dl class="lx-specs__list">
        {%- for block in section.blocks -%}
          <div class="lx-specs__row" {{ block.shopify_attributes }}><dt>{{ block.settings.key }}</dt><dd>{{ block.settings.value }}</dd></div>
        {%- endfor -%}
      </dl>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Laserix — specyfikacja",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — neonowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Panel (ciemny granat)" }, { "value": "pink", "label": "Czerwona poświata" }, { "value": "lilac", "label": "Fioletowa poświata" },
      { "value": "mint", "label": "Zielona poświata" }, { "value": "sky", "label": "Niebieska poświata" }, { "value": "sun", "label": "Żółta poświata" }, { "value": "none", "label": "Brak" } ]},
    { "type": "image_picker", "id": "image", "label": "Zdjęcie produktu" },
    { "type": "text", "id": "asset", "label": "Albo plik z Zasobów motywu", "default": "lx-dims.jpg" }
  ],
  "blocks": [
    { "type": "spec", "name": "Wiersz", "settings": [
      { "type": "text", "id": "key", "label": "Cecha", "default": "Cecha" },
      { "type": "text", "id": "value", "label": "Wartość", "default": "Wartość" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Laserix — specyfikacja" }]
}
{% endschema %}
