{%- comment -%} LASERIX — galeria zdjęć (np. efekty, zdjęcia od klientów) {%- endcomment -%}
{%- liquid
  assign has_img = false
  for block in section.blocks
    if block.settings.image != blank or block.settings.asset != blank
      assign has_img = true
    endif
  endfor
-%}
{%- if has_img or request.design_mode -%}
<section class="lx-sec lx-sec--{{ section.settings.bg }}">
  <div class="lx-container">
    {%- render 'lx-head', s: section.settings -%}
    <div class="lx-gal">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank or block.settings.asset != blank or request.design_mode -%}
        <figure class="lx-gal__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 25vw, 50vw' }}
          {%- elsif block.settings.asset != blank -%}
            <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="600" height="600">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption class="lx-gal__cap">{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Laserix — galeria",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — neonowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Panel (ciemny granat)" }, { "value": "pink", "label": "Czerwona poświata" }, { "value": "lilac", "label": "Fioletowa poświata" },
      { "value": "mint", "label": "Zielona poświata" }, { "value": "sky", "label": "Niebieska poświata" }, { "value": "sun", "label": "Żółta poświata" }, { "value": "none", "label": "Brak" } ]}
  ],
  "blocks": [
    { "type": "photo", "name": "Zdjęcie", "settings": [
      { "type": "image_picker", "id": "image", "label": "Zdjęcie" },
      { "type": "text", "id": "asset", "label": "Albo plik z Zasobów motywu", "info": "Np. lx-teams.jpg. Używane, gdy nie wybierzesz zdjęcia powyżej." },
      { "type": "text", "id": "caption", "label": "Podpis" }
    ]}
  ],
  "presets": [{ "name": "Laserix — galeria" }]
}
{% endschema %}
