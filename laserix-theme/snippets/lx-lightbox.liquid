{%- comment -%}
  LASERIX — pełnoekranowa przeglądarka zdjęć + efekt 3D (tilt) na kartach.
  Otwiera się: window.LXLightbox.open([{src, alt}], index) albo kliknięcie elementu z data-lx-group.
{%- endcomment -%}
<div class="lx-lb" id="lx-lb" role="dialog" aria-modal="true" aria-label="Podgląd zdjęcia" hidden>
  <button type="button" class="lx-lb__close" data-lb-close aria-label="Zamknij">✕</button>
  <button type="button" class="lx-lb__nav lx-lb__nav--prev" data-lb-prev aria-label="Poprzednie zdjęcie">‹</button>
  <figure class="lx-lb__stage" data-lb-stage>
    <img class="lx-lb__img" data-lb-img alt="" width="1200" height="1200" draggable="false">
  </figure>
  <button type="button" class="lx-lb__nav lx-lb__nav--next" data-lb-next aria-label="Następne zdjęcie">›</button>
  <div class="lx-lb__bar"><span data-lb-count></span><span class="lx-lb__tip">Kliknij dwukrotnie, aby przybliżyć</span></div>
</div>
<script>
(function(){
  var lb = document.getElementById('lx-lb'); if (!lb) return;
  var img = lb.querySelector('[data-lb-img]'), count = lb.querySelector('[data-lb-count]'), stage = lb.querySelector('[data-lb-stage]');
  var list = [], cur = 0, lastFocus = null, zoom = false;
  function render(){
    var it = list[cur]; zoom = false; stage.classList.remove('is-zoom');
    img.classList.add('is-swap');
    var pre = new Image(); pre.onload = pre.onerror = function(){ img.src = it.src; img.alt = it.alt || ''; img.classList.remove('is-swap'); };
    pre.src = it.src;
    count.textContent = (cur + 1) + ' / ' + list.length;
    lb.classList.toggle('is-single', list.length < 2);
  }
  function open(l, i){
    if (!l || !l.length) return;
    list = l; cur = Math.max(0, Math.min(i || 0, l.length - 1)); lastFocus = document.activeElement;
    lb.hidden = false; document.documentElement.classList.add('lx-lb-open');
    requestAnimationFrame(function(){ lb.classList.add('is-open'); });
    render(); lb.querySelector('[data-lb-close]').focus();
  }
  function close(){
    lb.classList.remove('is-open'); document.documentElement.classList.remove('lx-lb-open');
    setTimeout(function(){ lb.hidden = true; }, 200);
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  function go(d){ if (list.length < 2) return; cur = (cur + d + list.length) % list.length; render(); }
  lb.querySelector('[data-lb-close]').addEventListener('click', close);
  lb.querySelector('[data-lb-prev]').addEventListener('click', function(){ go(-1); });
  lb.querySelector('[data-lb-next]').addEventListener('click', function(){ go(1); });
  lb.addEventListener('click', function(e){ if (e.target === lb || e.target === stage) close(); });
  document.addEventListener('keydown', function(e){
    if (lb.hidden) return;
    if (e.key === 'Escape') close(); else if (e.key === 'ArrowLeft') go(-1); else if (e.key === 'ArrowRight') go(1);
  });
  img.addEventListener('dblclick', function(e){
    zoom = !zoom;
    var r = img.getBoundingClientRect();
    img.style.transformOrigin = ((e.clientX - r.left) / r.width * 100) + '% ' + ((e.clientY - r.top) / r.height * 100) + '%';
    stage.classList.toggle('is-zoom', zoom);
  });
  var sx = null;
  stage.addEventListener('touchstart', function(e){ if (e.touches.length === 1) sx = e.touches[0].clientX; }, { passive: true });
  stage.addEventListener('touchend', function(e){
    if (sx === null || zoom) { sx = null; return; }
    var dx = e.changedTouches[0].clientX - sx; sx = null;
    if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
  });
  window.LXLightbox = { open: open, close: close };

  /* grupy zdjęć na stronie (np. galeria) */
  function openGroup(el){
    var g = el.getAttribute('data-lx-group');
    var els = [].slice.call(document.querySelectorAll('[data-lx-group="' + g + '"]'));
    open(els.map(function(x){ return { src: x.getAttribute('data-full'), alt: x.getAttribute('data-alt') }; }), els.indexOf(el));
  }
  document.addEventListener('click', function(e){ var el = e.target.closest('[data-lx-group]'); if (el) openGroup(el); });
  document.addEventListener('keydown', function(e){
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var el = e.target.closest && e.target.closest('[data-lx-group]'); if (!el) return;
    e.preventDefault(); openGroup(el);
  });

  /* efekt 3D + światło pod kursorem */
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.lx-tilt').forEach(function(c){
      c.addEventListener('mousemove', function(e){
        var r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        c.style.setProperty('--mx', (x * 100) + '%'); c.style.setProperty('--my', (y * 100) + '%');
        c.style.transform = 'perspective(700px) rotateY(' + ((x - .5) * 14) + 'deg) rotateX(' + ((.5 - y) * 14) + 'deg) scale(1.03)';
      });
      c.addEventListener('mouseleave', function(){ c.style.transform = ''; });
    });
  }
})();
</script>
