{%- comment -%} ZOLUMI — obietnica marki / gwarancja {%- endcomment -%}
<section class="z-sec z-prom" id="z-prom-{{ section.id }}">
  <div class="z-wrap">
    <div class="z-prom__card z-reveal">
      <div class="z-prom__seal" aria-hidden="true">
        <svg viewBox="0 0 120 120"><defs><path id="zc-{{ section.id }}" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0"/></defs><text><textPath href="#zc-{{ section.id }}">✦ {{ section.settings.seal_text }} ✦ {{ section.settings.seal_text }}</textPath></text></svg>
        <strong>{{ section.settings.seal_big }}</strong>
      </div>
      <div class="z-prom__body">
        <span class="z-kicker">{{ section.settings.kicker }}</span>
        <h2 class="z-h2">{{ section.settings.heading }}</h2>
        <div class="z-prom__text">{{ section.settings.text }}</div>
        <ul class="z-prom__pts">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span aria-hidden="true">{{ block.settings.icon }}</span>{{ block.settings.text }}</li>{%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>
{%- style -%}
  #z-prom-{{ section.id }} .z-prom__card{position:relative;overflow:hidden;background:#fff;border-radius:32px;padding:32px 22px;box-shadow:var(--z-shadow);display:flex;flex-direction:column;align-items:center;gap:24px;text-align:center}
  #z-prom-{{ section.id }} .z-prom__card::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 0 0,rgba(255,201,60,.25),transparent 40%),radial-gradient(circle at 100% 100%,rgba(109,59,239,.18),transparent 45%);pointer-events:none}
  #z-prom-{{ section.id }} .z-prom__seal{position:relative;flex:none;width:150px;height:150px;border-radius:50%;background:var(--z-grad);color:#fff;display:grid;place-items:center;box-shadow:0 18px 36px -14px rgba(109,59,239,.7)}
  #z-prom-{{ section.id }} .z-prom__seal svg{position:absolute;inset:6px;width:calc(100% - 12px);height:calc(100% - 12px);animation:zSpin 18s linear infinite;fill:#fff;font-family:var(--z-body);font-weight:800;font-size:10.5px;letter-spacing:2.2px;text-transform:uppercase}
  #z-prom-{{ section.id }} .z-prom__seal strong{font-family:var(--z-head);font-size:46px;line-height:1}
  #z-prom-{{ section.id }} .z-prom__body{position:relative}
  #z-prom-{{ section.id }} .z-prom__text{color:var(--z-ink-soft);margin-top:12px}
  #z-prom-{{ section.id }} .z-prom__pts{list-style:none;padding:0;margin:18px 0 0;display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
  #z-prom-{{ section.id }} .z-prom__pts li{display:flex;align-items:center;gap:6px;font-weight:800;font-size:14px;background:var(--z-cream);padding:8px 14px;border-radius:999px}
  @media(min-width:900px){
    #z-prom-{{ section.id }} .z-prom__card{flex-direction:row;text-align:left;padding:52px 60px;gap:48px}
    #z-prom-{{ section.id }} .z-prom__seal{width:190px;height:190px}
    #z-prom-{{ section.id }} .z-prom__seal strong{font-size:58px}
    #z-prom-{{ section.id }} .z-prom__pts{justify-content:flex-start}
  }
{%- endstyle -%}
{% schema %}
{
  "name": "Obietnica / gwarancja",
  "settings": [
    { "type": "text", "id": "seal_big", "label": "Pieczęć — duży tekst", "default": "30" },
    { "type": "text", "id": "seal_text", "label": "Pieczęć — napis wokół", "default": "dni na zwrot" },
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "🤝 Obietnica Zolumi" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Uśmiech dziecka albo <em>zwrot pieniędzy</em>" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Masz 30 dni na przetestowanie Zolumi w domu. Jeśli nie zakochacie się w magicznym malowaniu, napisz do nas — zwrócimy pieniądze, bez zbędnych pytań.</p>" }
  ],
  "blocks": [ { "type": "point", "name": "Punkt", "settings": [
    { "type": "text", "id": "icon", "label": "Emoji", "default": "✅" },
    { "type": "text", "id": "text", "label": "Tekst", "default": "Bez ryzyka" }
  ] } ],
  "presets": [ { "name": "Obietnica / gwarancja" } ]
}
{% endschema %}
