{%- comment -%} ZOLUMI — pasek ogłoszeń + nagłówek z logo na środku {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="z-ann" id="z-ann-{{ section.id }}">
  <div class="z-ann__track" data-interval="{{ section.settings.ann_interval | times: 1000 }}">
    {%- for block in section.blocks -%}
      <p class="z-ann__item{% if forloop.first %} is-on{% endif %}" {{ block.shopify_attributes }}>
        {{ block.settings.text | replace: '[DOSTAWA]', '<strong data-z-delivery="label">w ciągu 2–4 dni</strong>' | replace: '[DZIEŃ]', '<strong data-z-delivery="day">wkrótce</strong>' }}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

<header class="z-hdr" id="z-hdr-{{ section.id }}">
  <div class="z-wrap z-hdr__in">
    <div class="z-hdr__left">
      <details class="z-hdr__menu">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <nav class="z-hdr__drop" aria-label="Menu">
          {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
          {%- if section.settings.menu == blank or section.settings.menu.links.size == 0 -%}
            <a href="{{ routes.root_url }}#kup">🎨 Kup Zolumi</a>
            <a href="{{ routes.root_url }}#jak-dziala">✨ Jak to działa</a>
            <a href="{{ routes.root_url }}#faq">❓ Pytania</a>
            <a href="/pages/kontakt">💌 Kontakt</a>
          {%- endif -%}
        </nav>
      </details>
      <nav class="z-hdr__nav" aria-label="Menu główne">
        {%- for link in section.settings.menu.links limit: 3 -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        {%- if section.settings.menu == blank or section.settings.menu.links.size == 0 -%}
          <a href="{{ routes.root_url }}#jak-dziala">Jak to działa</a>
          <a href="{{ routes.root_url }}#faq">Pytania</a>
        {%- endif -%}
      </nav>
    </div>

    <div class="z-hdr__logo">
      {%- render 'z-logo', size: section.settings.logo_size, tagline: section.settings.tagline, image: section.settings.logo_image -%}
    </div>

    <div class="z-hdr__right">
      <a href="/pages/kontakt" class="z-hdr__help">Pomoc</a>
      <a href="{{ routes.cart_url }}" class="z-hdr__cart" data-z-cart-open aria-label="Koszyk">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.3 10.4a2 2 0 0 1-2 1.6H8.3a2 2 0 0 1-2-1.6L5 8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg>
        <span class="z-hdr__count" data-z-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- style -%}
  #z-ann-{{ section.id }}{background:var(--z-ink);color:#fff;font-size:13.5px;position:relative;overflow:hidden}
  #z-ann-{{ section.id }}::after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--z-rainbow);background-size:200% 100%;animation:zShift 4s linear infinite}
  #z-ann-{{ section.id }} .z-ann__track{display:grid;max-width:1200px;margin:0 auto;padding:10px 16px 12px;text-align:center}
  #z-ann-{{ section.id }} .z-ann__item{grid-area:1/1;margin:0;font-weight:700;opacity:0;transform:translateY(8px);transition:opacity .45s,transform .45s}
  #z-ann-{{ section.id }} .z-ann__item.is-on{opacity:1;transform:none}
  #z-ann-{{ section.id }} strong{color:var(--z-yellow)}
  #z-hdr-{{ section.id }}{position:sticky;top:0;z-index:100;background:rgba(255,248,239,.86);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid rgba(30,20,70,.06)}
  #z-hdr-{{ section.id }} .z-hdr__in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:72px;padding-top:8px;padding-bottom:8px}
  #z-hdr-{{ section.id }} .z-hdr__left{display:flex;align-items:center;gap:22px}
  #z-hdr-{{ section.id }} .z-hdr__right{display:flex;align-items:center;justify-content:flex-end;gap:18px}
  #z-hdr-{{ section.id }} .z-hdr__nav{display:none;gap:22px}
  #z-hdr-{{ section.id }} .z-hdr__nav a,#z-hdr-{{ section.id }} .z-hdr__help{color:var(--z-ink);text-decoration:none;font-weight:800;font-size:15px}
  #z-hdr-{{ section.id }} .z-hdr__nav a:hover,#z-hdr-{{ section.id }} .z-hdr__help:hover{color:var(--z-violet)}
  #z-hdr-{{ section.id }} .z-hdr__help{display:none}
  #z-hdr-{{ section.id }} .z-hdr__menu{position:relative}
  #z-hdr-{{ section.id }} .z-hdr__menu summary{list-style:none;cursor:pointer;width:44px;height:44px;border-radius:14px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;background:#fff;box-shadow:var(--z-shadow-sm)}
  #z-hdr-{{ section.id }} .z-hdr__menu summary::-webkit-details-marker{display:none}
  #z-hdr-{{ section.id }} .z-hdr__menu summary span{width:20px;height:2.5px;border-radius:2px;background:var(--z-ink);transition:transform .25s,opacity .25s}
  #z-hdr-{{ section.id }} .z-hdr__menu[open] summary span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
  #z-hdr-{{ section.id }} .z-hdr__menu[open] summary span:nth-child(2){opacity:0}
  #z-hdr-{{ section.id }} .z-hdr__menu[open] summary span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}
  #z-hdr-{{ section.id }} .z-hdr__drop{position:absolute;top:calc(100% + 10px);left:0;min-width:230px;background:#fff;border-radius:20px;box-shadow:var(--z-shadow);padding:8px;display:flex;flex-direction:column;animation:zDrop .25s ease}
  #z-hdr-{{ section.id }} .z-hdr__drop a{padding:12px 14px;border-radius:12px;color:var(--z-ink);text-decoration:none;font-weight:800}
  #z-hdr-{{ section.id }} .z-hdr__drop a:hover{background:var(--z-cream)}
  @keyframes zDrop{from{opacity:0;transform:translateY(-6px)}}
  #z-hdr-{{ section.id }} .z-hdr__cart{position:relative;display:grid;place-items:center;width:48px;height:48px;border-radius:16px;background:var(--z-ink);color:#fff;box-shadow:0 10px 20px -8px rgba(30,20,70,.6);transition:transform .15s}
  #z-hdr-{{ section.id }} .z-hdr__cart:hover{transform:translateY(-2px) rotate(-4deg)}
  #z-hdr-{{ section.id }} .z-hdr__count{position:absolute;top:-7px;right:-7px;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:var(--z-pink);color:#fff;font-size:12px;font-weight:800;display:grid;place-items:center;border:2px solid var(--z-cream)}
  #z-hdr-{{ section.id }} .z-hdr__count.is-pop{animation:zPop .5s cubic-bezier(.3,1.8,.5,1)}
  @keyframes zPop{0%{transform:scale(.4)}100%{transform:scale(1)}}
  @media(min-width:900px){
    #z-hdr-{{ section.id }} .z-hdr__menu{display:none}
    #z-hdr-{{ section.id }} .z-hdr__nav,#z-hdr-{{ section.id }} .z-hdr__help{display:flex}
    #z-hdr-{{ section.id }} .z-hdr__in{min-height:84px}
  }
{%- endstyle -%}

<script>
  (function () {
    var t = document.querySelector('#z-ann-{{ section.id }} .z-ann__track'); if (!t) return;
    var items = t.querySelectorAll('.z-ann__item'); if (items.length < 2) return;
    var i = 0, ms = parseInt(t.getAttribute('data-interval'), 10) || 4000;
    setInterval(function () { items[i].classList.remove('is-on'); i = (i + 1) % items.length; items[i].classList.add('is-on'); }, ms);
  })();
</script>

{% schema %}
{
  "name": "Nagłówek",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo (obrazek)", "info": "Zostaw puste, aby użyć kolorowego logo tekstowego Zolumi." },
    { "type": "range", "id": "logo_size", "min": 28, "max": 64, "step": 2, "unit": "px", "label": "Wielkość logo", "default": 44 },
    { "type": "text", "id": "tagline", "label": "Napis pod logo", "default": "magiczne malowanie" },
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "header", "content": "Pasek ogłoszeń" },
    { "type": "range", "id": "ann_interval", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Zmiana co", "default": 4 }
  ],
  "blocks": [
    { "type": "message", "name": "Ogłoszenie", "settings": [
      { "type": "text", "id": "text", "label": "Tekst", "default": "🚚 Darmowa dostawa 0 zł", "info": "Wpisz [DOSTAWA], aby pokazać datę dostawy (np. „we wtorek, 20 października”), lub [DZIEŃ] — sam dzień." }
    ] }
  ]
}
{% endschema %}
