{%- comment -%} ZOLUMI — co jest w pudełku {%- endcomment -%}
<section class="z-sec z-box" id="z-box-{{ section.id }}">
  <div class="z-wrap z-box__grid">
    <div class="z-box__art z-reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: section.settings.heading | strip_html }}
      {%- else -%}
        {%- render 'z-palette-art' -%}
      {%- endif -%}
      <span class="z-box__gift" aria-hidden="true">🎁</span>
    </div>
    <div>
      <div class="z-reveal">
        <span class="z-kicker">{{ section.settings.kicker }}</span>
        <h2 class="z-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="z-lead" style="margin-left:0">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      <ul class="z-box__list">
        {%- for block in section.blocks -%}
          <li class="z-reveal" data-delay="{{ forloop.index0 | times: 80 }}" style="--c: {{ block.settings.color }}" {{ block.shopify_attributes }}>
            <span class="z-box__ico" aria-hidden="true">{{ block.settings.icon }}</span>
            <span class="z-box__name"><strong>{{ block.settings.title }}</strong>{%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}</span>
            <span class="z-box__qty">× {{ block.settings.qty }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>
{%- style -%}
  #z-box-{{ section.id }} .z-box__grid{display:grid;gap:32px;align-items:center}
  #z-box-{{ section.id }} .z-box__art{position:relative;border-radius:var(--z-radius);overflow:hidden;box-shadow:var(--z-shadow);background:#fff}
  #z-box-{{ section.id }} .z-box__art img,#z-box-{{ section.id }} .z-box__art .z-art{width:100%;height:auto;display:block}
  #z-box-{{ section.id }} .z-box__gift{position:absolute;right:16px;bottom:16px;font-size:44px;animation:zWiggle 2.4s ease-in-out infinite}
  #z-box-{{ section.id }} .z-box__list{list-style:none;padding:0;margin:24px 0 0;display:grid;gap:12px}
  #z-box-{{ section.id }} .z-box__list li{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;background:#fff;border-radius:20px;padding:14px 16px;box-shadow:var(--z-shadow-sm);border-left:6px solid var(--c)}
  #z-box-{{ section.id }} .z-box__ico{width:50px;height:50px;border-radius:16px;display:grid;place-items:center;font-size:26px;background:color-mix(in srgb,var(--c) 18%,#fff)}
  #z-box-{{ section.id }} .z-box__name strong{display:block;font-size:16.5px}
  #z-box-{{ section.id }} .z-box__name small{display:block;color:var(--z-ink-soft);font-size:13.5px}
  #z-box-{{ section.id }} .z-box__qty{font-family:var(--z-head);font-weight:800;font-size:22px;color:var(--c)}
  @media(min-width:900px){#z-box-{{ section.id }} .z-box__grid{grid-template-columns:1fr 1fr;gap:60px}}
{%- endstyle -%}
{% schema %}
{
  "name": "Co w pudełku",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Nadtytuł", "default": "🎁 W zestawie" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Wszystko, czego potrzeba do <em>magii</em>" },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "image_picker", "id": "image", "label": "Zdjęcie zestawu" }
  ],
  "blocks": [ { "type": "item", "name": "Element", "settings": [
    { "type": "text", "id": "icon", "label": "Emoji", "default": "🎨" },
    { "type": "color", "id": "color", "label": "Kolor", "default": "#6d3bef" },
    { "type": "text", "id": "title", "label": "Nazwa", "default": "Magiczna paleta" },
    { "type": "text", "id": "text", "label": "Opis" },
    { "type": "text", "id": "qty", "label": "Ilość", "default": "1" }
  ] } ],
  "presets": [ { "name": "Co w pudełku", "blocks": [ { "type": "item" } ] } ]
}
{% endschema %}
