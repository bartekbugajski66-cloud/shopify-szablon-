{%- comment -%} ZOLUMI — końcowe wezwanie do zakupu z licznikiem dostawy {%- endcomment -%}
{%- assign p = section.settings.product | default: product | default: settings.featured_product -%}
<section class="z-final" id="z-final-{{ section.id }}">
  <div class="z-final__paint" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="z-wrap z-final__in z-reveal">
    <span class="z-final__emoji" aria-hidden="true">🎨✨🧒</span>
    <h2 class="z-h2">{{ section.settings.heading }}</h2>
    <p class="z-final__lead">{{ section.settings.text }}</p>

    <div class="z-final__cd" data-z-countdown="parts" aria-label="Czas do końca dnia zamówień">
      <div><b data-h>00</b><small>godz.</small></div><span>:</span>
      <div><b data-m>00</b><small>min</small></div><span>:</span>
      <div><b data-s>00</b><small>sek</small></div>
    </div>
    <p class="z-final__eta">🚚 Zamów teraz — paczka u Ciebie <strong data-z-delivery="label">w ciągu 2–4 dni</strong></p>

    <a href="{% if p != blank and request.page_type != 'product' %}{{ p.url }}{% endif %}#kup" class="z-btn z-final__btn">{{ section.settings.cta }}{% if p != blank %} · od {{ p.price_min | money }}{% endif %}</a>
    <p class="z-final__small">Dostawa 0 zł · 30 dni na zwrot · Bezpieczne płatności</p>
  </div>
</section>
{%- style -%}
  #z-final-{{ section.id }}{position:relative;overflow:hidden;background:var(--z-ink);color:#fff;padding:72px 0;text-align:center}
  #z-final-{{ section.id }} .z-final__paint i{position:absolute;width:220px;height:220px;border-radius:43% 57% 61% 39%/45% 38% 62% 55%;opacity:.55;filter:blur(2px);animation:zSplat 7s ease-in-out infinite,zFloat 16s ease-in-out infinite}
  #z-final-{{ section.id }} .z-final__paint i:nth-child(1){background:#ff4d5e;left:-60px;top:-40px}
  #z-final-{{ section.id }} .z-final__paint i:nth-child(2){background:#ffc93c;right:-70px;top:20px;animation-delay:-2s}
  #z-final-{{ section.id }} .z-final__paint i:nth-child(3){background:#1fbf75;left:10%;bottom:-120px;animation-delay:-4s}
  #z-final-{{ section.id }} .z-final__paint i:nth-child(4){background:#2f8bff;right:12%;bottom:-110px;animation-delay:-6s}
  #z-final-{{ section.id }} .z-final__paint i:nth-child(5){background:#6d3bef;left:45%;top:-150px;animation-delay:-3s}
  #z-final-{{ section.id }} .z-final__paint i:nth-child(6){background:#ff4fa3;right:-90px;bottom:30%;width:160px;height:160px;animation-delay:-5s}
  #z-final-{{ section.id }} .z-final__in{position:relative;max-width:760px}
  #z-final-{{ section.id }} .z-final__emoji{font-size:46px;letter-spacing:8px;display:block;margin-bottom:10px;animation:zBob 3s ease-in-out infinite}
  #z-final-{{ section.id }} .z-final__lead{color:rgba(255,255,255,.8);font-size:17px;margin:14px auto 26px;max-width:560px}
  #z-final-{{ section.id }} .z-final__cd{display:inline-flex;align-items:flex-start;gap:8px;background:rgba(255,255,255,.08);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.14);border-radius:24px;padding:14px 18px}
  #z-final-{{ section.id }} .z-final__cd div{display:flex;flex-direction:column;align-items:center;min-width:64px}
  #z-final-{{ section.id }} .z-final__cd b{font-family:var(--z-head);font-size:44px;line-height:1;background:#fff;color:var(--z-ink);border-radius:16px;padding:8px 10px;min-width:64px;box-shadow:inset 0 -4px 0 rgba(0,0,0,.08)}
  #z-final-{{ section.id }} .z-final__cd small{margin-top:6px;font-size:12px;font-weight:800;opacity:.7;text-transform:uppercase;letter-spacing:.06em}
  #z-final-{{ section.id }} .z-final__cd span{font-family:var(--z-head);font-size:38px;line-height:1.3;animation:zBlink 1s steps(1) infinite}
  #z-final-{{ section.id }} .z-final__eta{margin:18px 0 24px;font-size:16px}
  #z-final-{{ section.id }} .z-final__eta strong{color:var(--z-yellow)}
  #z-final-{{ section.id }} .z-final__btn{font-size:21px;padding:21px 34px}
  #z-final-{{ section.id }} .z-final__small{margin:14px 0 0;font-size:13.5px;opacity:.7}
  @media(min-width:900px){#z-final-{{ section.id }}{padding:110px 0}}
{%- endstyle -%}
{% schema %}
{
  "name": "Końcowe CTA + licznik",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Daj dziecku <em>magię</em>, a sobie spokój" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Godziny kreatywnej zabawy bez ekranu i bez sprzątania. Zamów dziś, a za chwilę będziecie malować razem." },
    { "type": "text", "id": "cta", "label": "Tekst przycisku", "default": "Chcę Zolumi 🎨" }
  ],
  "presets": [ { "name": "Końcowe CTA + licznik" } ]
}
{% endschema %}
