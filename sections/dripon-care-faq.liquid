{%- comment -%} DripON — Pielęgnacja (zdjęcia) + FAQ (styl THEVIREA) {%- endcomment -%}
<section class="drip-cf" id="drip-cf-{{ section.id }}">

  {%- if section.settings.care_enable -%}
  <div class="drip-sec drip-sec--bg">
    <div class="drip-container drip-center">
      {%- if section.settings.care_eyebrow != blank -%}<span class="drip-eyebrow">{{ section.settings.care_eyebrow }}</span>{%- endif -%}
      <h2 class="drip-h2">{{ section.settings.care_heading }}</h2>
      {%- if section.settings.care_sub != blank -%}<p class="drip-lead">{{ section.settings.care_sub }}</p>{%- endif -%}
      <div class="drip-cf__steps">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          {%- assign n = n | plus: 1 -%}
          <div class="drip-cf__step" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width:700 | image_tag: loading:'lazy', class:'drip-cf__stepimg', alt: block.settings.title | escape }}
            {%- else -%}<span class="drip-cf__stepph"></span>{%- endif -%}
            <div class="drip-cf__stepbody">
              <span class="drip-cf__num">{{ n }}</span>
              <h3 class="drip-cf__steptitle">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p class="drip-cf__steptext">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- if section.settings.faq_enable -%}
  <div class="drip-sec">
    <div class="drip-container drip-center">
      {%- if section.settings.faq_eyebrow != blank -%}<span class="drip-eyebrow">{{ section.settings.faq_eyebrow }}</span>{%- endif -%}
      <h2 class="drip-h2">{{ section.settings.faq_heading }}</h2>
    </div>
    <div class="drip-container drip-cf__faq">
      {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
        <details class="drip-cf__item" {{ block.shopify_attributes }}>
          <summary class="drip-cf__q"><span>{{ block.settings.question }}</span><span class="drip-cf__sign" aria-hidden="true"></span></summary>
          <div class="drip-cf__a">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}{%- endfor -%}
    </div>
  </div>
  {%- endif -%}

</section>
{%- style -%}
  #drip-cf-{{ section.id }} .drip-cf__steps{display:grid;grid-template-columns:1fr;gap:18px;margin-top:8px;text-align:left}
  #drip-cf-{{ section.id }} .drip-cf__step{background:#fff;border:1px solid var(--drip-line);border-radius:16px;overflow:hidden}
  #drip-cf-{{ section.id }} .drip-cf__stepimg,#drip-cf-{{ section.id }} .drip-cf__stepph{width:100%;aspect-ratio:16/10;object-fit:cover;background:var(--drip-bg);display:block}
  #drip-cf-{{ section.id }} .drip-cf__stepbody{padding:16px 18px}
  #drip-cf-{{ section.id }} .drip-cf__num{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#d8f1f3;color:var(--drip-blue);font-size:12px;font-weight:800;margin-bottom:8px}
  #drip-cf-{{ section.id }} .drip-cf__steptitle{margin:0 0 4px;font-size:15px;font-weight:800}
  #drip-cf-{{ section.id }} .drip-cf__steptext{margin:0;font-size:13px;color:var(--drip-ink);line-height:1.5}
  #drip-cf-{{ section.id }} .drip-cf__faq{max-width:820px;display:flex;flex-direction:column;gap:10px}
  #drip-cf-{{ section.id }} .drip-cf__item{background:#fff;border:1px solid var(--drip-line);border-radius:14px;overflow:hidden}
  #drip-cf-{{ section.id }} .drip-cf__q{display:flex;align-items:center;justify-content:space-between;gap:14px;cursor:pointer;list-style:none;padding:18px 20px;font-size:15px;font-weight:700}
  #drip-cf-{{ section.id }} .drip-cf__q::-webkit-details-marker{display:none}
  #drip-cf-{{ section.id }} .drip-cf__sign{flex:none;position:relative;width:26px;height:26px;border-radius:50%;background:#d8f1f3}
  #drip-cf-{{ section.id }} .drip-cf__sign::before,#drip-cf-{{ section.id }} .drip-cf__sign::after{content:"";position:absolute;left:50%;top:50%;width:11px;height:2px;background:var(--drip-blue);transform:translate(-50%,-50%);border-radius:2px}
  #drip-cf-{{ section.id }} .drip-cf__sign::after{transform:translate(-50%,-50%) rotate(90deg);transition:opacity .2s}
  #drip-cf-{{ section.id }} .drip-cf__item[open] .drip-cf__sign::after{opacity:0}
  #drip-cf-{{ section.id }} .drip-cf__item[open] .drip-cf__sign{background:var(--drip-blue)}
  #drip-cf-{{ section.id }} .drip-cf__item[open] .drip-cf__sign::before{background:#fff}
  #drip-cf-{{ section.id }} .drip-cf__a{padding:0 20px 18px;font-size:14px;color:var(--drip-ink);line-height:1.6}
  @media(min-width:900px){#drip-cf-{{ section.id }} .drip-cf__steps{grid-template-columns:repeat(3,1fr)}}
{%- endstyle -%}
{% schema %}
{
  "name": "DripON • Pielęgnacja+FAQ",
  "settings": [
    { "type":"header","content":"Pielęgnacja" },
    { "type":"checkbox","id":"care_enable","label":"Pokaż pielęgnację","default":true },
    { "type":"text","id":"care_eyebrow","label":"Nadtytuł","default":"PIELĘGNACJA" },
    { "type":"text","id":"care_heading","label":"Nagłówek","default":"Jak dbać o DripON?" },
    { "type":"textarea","id":"care_sub","label":"Podnagłówek","default":"Prosta pielęgnacja. Wystarczy regularne pranie i suszenie, by zachować chłonność na lata." },
    { "type":"header","content":"FAQ" },
    { "type":"checkbox","id":"faq_enable","label":"Pokaż FAQ","default":true },
    { "type":"text","id":"faq_eyebrow","label":"Nadtytuł","default":"FAQ" },
    { "type":"text","id":"faq_heading","label":"Nagłówek","default":"Najczęstsze pytania" }
  ],
  "blocks": [
    { "type":"step","name":"Krok pielęgnacji","settings":[
      {"type":"image_picker","id":"image","label":"Zdjęcie"},
      {"type":"text","id":"title","label":"Tytuł","default":"Wypierz przed użyciem"},
      {"type":"textarea","id":"text","label":"Opis","default":"Pierz w 30–40°C bez płynu do płukania."}
    ] },
    { "type":"faq","name":"Pytanie","settings":[
      {"type":"text","id":"question","label":"Pytanie","default":"Czy DripON rysuje lakier?"},
      {"type":"textarea","id":"answer","label":"Odpowiedź","default":"Nie. Miękka mikrofibra premium delikatnie zbiera wodę i minimalizuje ryzyko mikro-zarysowań."}
    ] }
  ],
  "presets": [ { "name":"DripON • Pielęgnacja+FAQ", "blocks":[
    {"type":"step","settings":{"title":"Wypierz przed użyciem","text":"Pierz w 30–40°C bez płynu do płukania, by aktywować pełną chłonność."}},
    {"type":"step","settings":{"title":"Susz naturalnie","text":"Unikaj suszarki i wysokich temperatur — to chroni włókna mikrofibry."}},
    {"type":"step","settings":{"title":"Używaj na czysty lakier","text":"Najlepsze efekty na umytym aucie, bez piasku i zabrudzeń."}},
    {"type":"faq","settings":{"question":"Kiedy poczuję różnicę?","answer":"Już przy pierwszym osuszaniu — DripON zbiera wodę szybciej i bez smug niż zwykła szmatka."}},
    {"type":"faq","settings":{"question":"Czym DripON różni się od taniej szmatki?","answer":"Gramaturą 1200GSM, miękkim splotem premium i dużym formatem 60×90 cm, który osusza w kilka ruchów."}},
    {"type":"faq","settings":{"question":"Czy naprawdę mogę zwrócić produkt po 30 dniach?","answer":"Tak. Masz 30 dni na test. Jeśli nie poczujesz różnicy, zwrócimy pieniądze."}},
    {"type":"faq","settings":{"question":"Czy wystarczy jeden ręcznik na całe auto?","answer":"W większości przypadków tak. Przy dużych SUV-ach wygodniej pracuje się dwoma."}},
    {"type":"faq","settings":{"question":"Czy nadaje się do szyb?","answer":"Tak, świetnie sprawdza się na szybach i karoserii, nie zostawiając smug."}},
    {"type":"faq","settings":{"question":"Jak dbać o ręcznik?","answer":"Pierz w 30–40°C bez płynu do płukania i susz naturalnie."}},
    {"type":"faq","settings":{"question":"Kiedy otrzymam zamówienie?","answer":"Wysyłamy ekspresowo — przesyłka zwykle dociera w 1–3 dni robocze."}}
  ] } ]
}
{% endschema %}
