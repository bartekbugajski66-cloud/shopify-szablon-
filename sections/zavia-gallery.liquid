{%- comment -%} ZAVIA — galeria zdjęć (np. efekty, zdjęcia od klientów) {%- endcomment -%}
{%- liquid
  assign has_img = false
  for block in section.blocks
    if block.settings.image != blank
      assign has_img = true
    endif
  endfor
-%}
{%- if has_img or request.design_mode -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    {%- render 'zv-head', s: section.settings -%}
    <div class="zv-gal">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank or request.design_mode -%}
        <figure class="zv-gal__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 25vw, 50vw' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption class="zv-gal__cap">{{ block.settings.caption }}</figcaption>{%- endif -%}
        </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Zavia — galeria",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — tęczowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" },
      { "value": "mint", "label": "Miętowe" }, { "value": "sky", "label": "Błękitne" }, { "value": "sun", "label": "Słoneczne" }, { "value": "none", "label": "Brak" } ]}
  ],
  "blocks": [
    { "type": "photo", "name": "Zdjęcie", "settings": [
      { "type": "image_picker", "id": "image", "label": "Zdjęcie" },
      { "type": "text", "id": "caption", "label": "Podpis" }
    ]}
  ],
  "presets": [{ "name": "Zavia — galeria" }]
}
{% endschema %}
