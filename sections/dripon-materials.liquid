{%- comment -%} DripON — Materiały (zdjęcie + tabela, styl THEVIREA) {%- endcomment -%}
<section class="drip-mat drip-sec drip-sec--bg" id="drip-mat-{{ section.id }}">
  <div class="drip-container">
    <div class="drip-mat__head">
      {%- if section.settings.eyebrow != blank -%}<span class="drip-eyebrow drip-eyebrow--green">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="drip-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="drip-lead">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="drip-mat__grid">
      <div class="drip-mat__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width:900 | image_tag: loading:'lazy', class:'drip-mat__img', alt: section.settings.heading | escape }}
        {%- else -%}<span class="drip-mat__ph"></span>{%- endif -%}
      </div>
      <dl class="drip-mat__table">
        {%- for block in section.blocks -%}
          <div class="drip-mat__row" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.key }}</dt>
            <dd>{{ block.settings.value }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    </div>
  </div>
</section>
{%- style -%}
  #drip-mat-{{ section.id }} .drip-mat__head{max-width:560px;margin:0 0 30px}
  #drip-mat-{{ section.id }} .drip-mat__grid{display:grid;grid-template-columns:1fr;gap:24px;align-items:center}
  #drip-mat-{{ section.id }} .drip-mat__img,#drip-mat-{{ section.id }} .drip-mat__ph{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:18px;background:#fff;display:block}
  #drip-mat-{{ section.id }} .drip-mat__table{margin:0}
  #drip-mat-{{ section.id }} .drip-mat__row{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px 0;border-bottom:1px solid var(--drip-line)}
  #drip-mat-{{ section.id }} .drip-mat__row dt{margin:0;font-weight:700;font-size:14.5px;color:var(--drip-ink)}
  #drip-mat-{{ section.id }} .drip-mat__row dd{margin:0;font-weight:700;font-size:14.5px;text-align:right}
  @media(min-width:900px){#drip-mat-{{ section.id }} .drip-mat__grid{grid-template-columns:1fr 1fr;gap:48px}}
{%- endstyle -%}
{% schema %}
{
  "name": "DripON • Materiały",
  "settings": [
    { "type":"text","id":"eyebrow","label":"Nadtytuł","default":"MATERIAŁY" },
    { "type":"text","id":"heading","label":"Nagłówek","default":"Jakość, której możesz zaufać" },
    { "type":"textarea","id":"subheading","label":"Podnagłówek","default":"Zaprojektowany z myślą o chłonności, trwałości i bezpieczeństwie Twojego lakieru." },
    { "type":"image_picker","id":"image","label":"Zdjęcie produktu" }
  ],
  "blocks": [ { "type":"spec","name":"Wiersz","settings":[
    {"type":"text","id":"key","label":"Cecha","default":"Materiał"},
    {"type":"text","id":"value","label":"Wartość","default":"Mikrofibra premium"}
  ] } ],
  "max_blocks": 10,
  "presets": [ { "name":"DripON • Materiały", "blocks":[
    {"type":"spec","settings":{"key":"Materiał","value":"Mikrofibra premium"}},
    {"type":"spec","settings":{"key":"Gramatura","value":"1200GSM"}},
    {"type":"spec","settings":{"key":"Rozmiar","value":"60 × 90 cm"}},
    {"type":"spec","settings":{"key":"Zastosowanie","value":"Osuszanie auta po myciu"}},
    {"type":"spec","settings":{"key":"Bezpieczeństwo","value":"Delikatny dla lakieru"}},
    {"type":"spec","settings":{"key":"Pielęgnacja","value":"Prać bez płynu do płukania · 30–40°C"}}
  ] } ]
}
{% endschema %}
