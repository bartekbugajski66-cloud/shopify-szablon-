{%- comment -%}
  ZAVIA — spadające emotki / tęcze na całej stronie + wybuch emotek (window.zaviaBurst)
{%- endcomment -%}
{%- if section.settings.enable -%}
<div class="zv-sprinkles" id="zv-sprinkles" aria-hidden="true"
  data-emojis="{{ section.settings.emojis | escape }}"
  data-count="{{ section.settings.count }}"
  data-mobile="{{ section.settings.count_mobile }}"
  data-opacity="{{ section.settings.opacity }}"></div>
{%- endif -%}
<script>
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var defaults = {{ section.settings.burst_emojis | default: '🌈,✨,💖,🦄,⭐,💅,🍭,🎀' | split: ',' | json }};
  function list(str){ return (str||'').split(',').map(function(s){return s.trim()}).filter(Boolean); }

  /* globalny „wybuch” emotek — używany m.in. przy wyborze pakietu i dodaniu do koszyka */
  window.zaviaBurst = function(x, y, n){
    if (reduce) return;
    var em = defaults.map(function(s){return s.trim()}).filter(Boolean);
    n = n || 14;
    for (var i = 0; i < n; i++) {
      var s = document.createElement('span');
      s.className = 'zv-burst';
      s.textContent = em[Math.floor(Math.random() * em.length)];
      var ang = Math.random() * Math.PI * 2, dist = 60 + Math.random() * 110;
      s.style.left = x + 'px'; s.style.top = y + 'px';
      s.style.setProperty('--dx', Math.cos(ang) * dist + 'px');
      s.style.setProperty('--dy', Math.sin(ang) * dist - 30 + 'px');
      s.style.setProperty('--rot', (Math.random() * 120 - 60) + 'deg');
      s.style.fontSize = (18 + Math.random() * 16) + 'px';
      document.body.appendChild(s);
      setTimeout(function(el){ return function(){ el.remove(); }; }(s), 1000);
    }
  };

  var box = document.getElementById('zv-sprinkles');
  if (!box || reduce) return;
  var em = list(box.getAttribute('data-emojis'));
  if (!em.length) return;
  var mobile = window.innerWidth < 750;
  var n = parseInt(box.getAttribute(mobile ? 'data-mobile' : 'data-count'), 10) || 0;
  var op = (parseInt(box.getAttribute('data-opacity'), 10) || 80) / 100;
  for (var i = 0; i < n; i++) {
    var s = document.createElement('span');
    s.className = 'zv-sprinkle';
    s.textContent = em[i % em.length];
    var size = 14 + Math.random() * 18;
    s.style.left = (Math.random() * 100) + 'vw';
    s.style.fontSize = size + 'px';
    s.style.opacity = op;
    s.style.animationDuration = (11 + Math.random() * 12) + 's';
    s.style.animationDelay = (-Math.random() * 20) + 's';
    box.appendChild(s);
  }
  /* pauza, gdy karta nie jest widoczna */
  document.addEventListener('visibilitychange', function(){
    box.style.display = document.hidden ? 'none' : '';
  });
})();
</script>

{% schema %}
{
  "name": "Zavia — spadające emotki",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Włącz spadające emotki", "default": true },
    { "type": "text", "id": "emojis", "label": "Emotki (po przecinku)", "default": "🌈,✨,💖,🦄,⭐,💅,🍭,🎀,🌸,🍬" },
    { "type": "range", "id": "count", "label": "Ilość — komputer", "min": 0, "max": 40, "step": 1, "default": 18 },
    { "type": "range", "id": "count_mobile", "label": "Ilość — telefon", "min": 0, "max": 30, "step": 1, "default": 10 },
    { "type": "range", "id": "opacity", "label": "Widoczność (%)", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 75 },
    { "type": "text", "id": "burst_emojis", "label": "Emotki „wybuchu” po kliknięciu (po przecinku)", "default": "🌈,✨,💖,🦄,⭐,💅,🍭,🎀" }
  ],
  "presets": [{ "name": "Zavia — spadające emotki" }]
}
{% endschema %}
