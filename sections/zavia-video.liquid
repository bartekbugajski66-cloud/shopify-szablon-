{%- comment -%} ZAVIA — filmy (pionowe, jak z TikToka/Reels) {%- endcomment -%}
{%- liquid
  assign has_video = false
  for block in section.blocks
    if block.settings.video_file != blank or block.settings.link != blank
      assign has_video = true
    endif
  endfor
-%}
{%- if has_video or request.design_mode -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    {%- render 'zv-head', s: section.settings -%}
    <div class="zv-vids">
      {%- for block in section.blocks -%}
        <div class="zv-vid" {{ block.shopify_attributes }}>
          {%- if block.settings.video_file != blank -%}
            {{ block.settings.video_file | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '600x' }}
            <button type="button" class="zv-vid__sound" aria-label="Włącz dźwięk">🔇</button>
          {%- elsif block.settings.link != blank -%}
            <button type="button" class="zv-vid__poster" data-embed="{{ block.settings.link.type }}" data-id="{{ block.settings.link.id }}" aria-label="Odtwórz film">
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              <span class="zv-vid__play" aria-hidden="true">▶</span>
            </button>
          {%- else -%}
            <div class="zv-vid__empty">🎬<br>Dodaj film</div>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<span class="zv-vid__cap">{{ block.settings.caption }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
(function(){
  document.querySelectorAll('#shopify-section-{{ section.id }} .zv-vid__sound').forEach(function(b){
    b.addEventListener('click', function(){
      var v = b.parentNode.querySelector('video'); if (!v) return;
      v.muted = !v.muted; if (!v.muted) v.play();
      b.textContent = v.muted ? '🔇' : '🔊';
      b.setAttribute('aria-label', v.muted ? 'Włącz dźwięk' : 'Wycisz');
    });
  });
  document.querySelectorAll('#shopify-section-{{ section.id }} .zv-vid__poster').forEach(function(b){
    b.addEventListener('click', function(){
      var t = b.getAttribute('data-embed'), id = b.getAttribute('data-id'), src = '';
      if (t === 'youtube') src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&playsinline=1&rel=0';
      else if (t === 'vimeo') src = 'https://player.vimeo.com/video/' + id + '?autoplay=1';
      if (!src) return;
      var f = document.createElement('iframe');
      f.src = src; f.allow = 'autoplay; encrypted-media; picture-in-picture'; f.allowFullscreen = true; f.title = 'Film';
      b.replaceWith(f);
    });
  });
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Zavia — filmy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — tęczowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" },
      { "value": "mint", "label": "Miętowe" }, { "value": "sky", "label": "Błękitne" }, { "value": "sun", "label": "Słoneczne" }, { "value": "none", "label": "Brak" } ]}
  ],
  "blocks": [
    { "type": "video", "name": "Film", "settings": [
      { "type": "video", "id": "video_file", "label": "Film — wgraj plik", "info": "Najlepiej pionowy (9:16). Odtwarza się sam, bez dźwięku." },
      { "type": "video_url", "id": "link", "label": "Lub link YouTube / Vimeo", "accept": ["youtube", "vimeo"] },
      { "type": "image_picker", "id": "image", "label": "Miniatura (dla linku)" },
      { "type": "text", "id": "caption", "label": "Podpis" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Zavia — filmy", "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }] }]
}
{% endschema %}
