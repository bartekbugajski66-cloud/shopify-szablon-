{%- comment -%} ZAVIA — „Brzmi znajomo?” problemy rodziców {%- endcomment -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    {%- render 'zv-head', s: section.settings -%}
    <div class="zv-probs">
      {%- for block in section.blocks -%}
        <div class="zv-prob" {{ block.shopify_attributes }}>
          <span class="zv-prob__ico" aria-hidden="true">{{ block.settings.icon }}</span>
          <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.answer != blank -%}
      <div class="zv-probs__answer"><span aria-hidden="true">👇</span> {{ section.settings.answer }}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Zavia — problemy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — tęczowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" },
      { "value": "mint", "label": "Miętowe" }, { "value": "sky", "label": "Błękitne" }, { "value": "sun", "label": "Słoneczne" }, { "value": "none", "label": "Brak" } ]},
    { "type": "text", "id": "answer", "label": "Odpowiedź pod kartami", "default": "Właśnie dlatego powstała Zavia." }
  ],
  "blocks": [
    { "type": "problem", "name": "Problem", "settings": [
      { "type": "text", "id": "icon", "label": "Emotka", "default": "😩" },
      { "type": "text", "id": "title", "label": "Tytuł", "default": "Problem" },
      { "type": "textarea", "id": "text", "label": "Opis" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Zavia — problemy" }]
}
{% endschema %}
