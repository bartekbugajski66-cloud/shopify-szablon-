{%- comment -%} ZOLUMI — przesuwający się pasek haseł {%- endcomment -%}
<div class="z-mq" id="z-mq-{{ section.id }}" style="--speed: {{ section.settings.speed }}s">
  <div class="z-mq__row" aria-hidden="true">
    {%- for i in (1..2) -%}
      <div class="z-mq__set">
        {%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span><i>✦</i>{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  <p class="visually-hidden">{%- for block in section.blocks -%}{{ block.settings.text }}{% unless forloop.last %}, {% endunless %}{%- endfor -%}</p>
</div>
{%- style -%}
  #z-mq-{{ section.id }}{background:var(--z-grad);color:#fff;overflow:hidden;padding:16px 0;transform:rotate(-1.2deg);margin:10px -10px;box-shadow:0 14px 30px -16px rgba(109,59,239,.6)}
  #z-mq-{{ section.id }} .z-mq__row{display:flex;width:max-content;animation:zMq var(--speed) linear infinite}
  #z-mq-{{ section.id }} .z-mq__set{display:flex;align-items:center;gap:22px;padding-right:22px;font-family:var(--z-head);font-weight:800;font-size:clamp(18px,3.4vw,26px);white-space:nowrap}
  #z-mq-{{ section.id }} i{font-style:normal;color:var(--z-yellow)}
  @keyframes zMq{to{transform:translateX(-50%)}}
{%- endstyle -%}
{% schema %}
{
  "name": "Pasek haseł",
  "settings": [ { "type": "range", "id": "speed", "min": 10, "max": 60, "step": 2, "unit": "s", "label": "Czas przewinięcia", "default": 28 } ],
  "blocks": [ { "type": "item", "name": "Hasło", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "🎨 Zero plam" } ] } ],
  "presets": [ { "name": "Pasek haseł", "blocks": [ { "type": "item" } ] } ]
}
{% endschema %}
