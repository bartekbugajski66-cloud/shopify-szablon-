{%- comment -%} DripON — Co dostajesz (styl THEVIREA) {%- endcomment -%}
<section class="drip-wyg drip-sec" id="drip-wyg-{{ section.id }}">
  <div class="drip-container">
    <div class="drip-wyg__head">
      {%- if section.settings.eyebrow != blank -%}<span class="drip-eyebrow drip-eyebrow--amber">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="drip-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="drip-wyg__grid">
      {%- for block in section.blocks -%}
        <div class="drip-wyg__card" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}<span class="drip-wyg__badge">{{ block.settings.badge }}</span>{%- endif -%}
          <span class="drip-wyg__ico" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3 class="drip-wyg__title">{{ block.settings.title }}</h3>
          <p class="drip-wyg__desc">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- style -%}
  #drip-wyg-{{ section.id }} .drip-wyg__head{margin:0 0 28px}
  #drip-wyg-{{ section.id }} .drip-wyg__grid{display:grid;grid-template-columns:1fr;gap:16px}
  #drip-wyg-{{ section.id }} .drip-wyg__card{position:relative;background:#fff;border:1px solid var(--drip-line);border-radius:16px;padding:24px 22px;box-shadow:0 2px 12px rgba(15,23,42,.04)}
  #drip-wyg-{{ section.id }} .drip-wyg__badge{position:absolute;top:14px;right:14px;background:var(--drip-green);color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.04em;padding:4px 10px;border-radius:999px}
  #drip-wyg-{{ section.id }} .drip-wyg__ico{font-size:30px;display:block;margin-bottom:12px}
  #drip-wyg-{{ section.id }} .drip-wyg__title{margin:0 0 6px;font-size:17px;font-weight:800}
  #drip-wyg-{{ section.id }} .drip-wyg__desc{margin:0;font-size:14px;color:var(--drip-ink);line-height:1.55}
  @media(min-width:900px){#drip-wyg-{{ section.id }} .drip-wyg__grid{grid-template-columns:1fr 1fr;gap:22px}}
{%- endstyle -%}
{% schema %}
{
  "name": "DripON • Co dostajesz",
  "settings": [
    { "type":"text","id":"eyebrow","label":"Nadtytuł","default":"CO DOSTAJESZ" },
    { "type":"text","id":"heading","label":"Nagłówek","default":"Kompletny zestaw do osuszania" }
  ],
  "blocks": [ { "type":"item","name":"Element","settings":[
    {"type":"text","id":"icon","label":"Emoji","default":"🧽"},
    {"type":"text","id":"badge","label":"Plakietka (np. GRATIS)"},
    {"type":"text","id":"title","label":"Tytuł","default":"Ręcznik DripON 1200GSM"},
    {"type":"textarea","id":"text","label":"Opis","default":"Mikrofibra premium, format 60×90 cm. Gotowy do użycia od pierwszego mycia."}
  ] } ],
  "max_blocks": 6,
  "presets": [ { "name":"DripON • Co dostajesz", "blocks":[
    {"type":"item","settings":{"icon":"🧽","title":"Ręcznik DripON 1200GSM","text":"Mikrofibra premium, format 60×90 cm. Gotowy do użycia od pierwszego mycia."}},
    {"type":"item","settings":{"icon":"🧴","badge":"W ZESTAWIE","title":"Ręcznik do szyb","text":"Mniejszy ręcznik do szyb i lusterek — bez smug i zacieków."}},
    {"type":"item","settings":{"icon":"📘","badge":"GRATIS","title":"E-book „Detailing w domu\"","text":"Wskazówki, jak myć i osuszać auto jak profesjonalista. Wysyłka elektroniczna."}},
    {"type":"item","settings":{"icon":"🔒","title":"Ochrona Kupującego","text":"30-dniowa gwarancja satysfakcji. Jeśli ręcznik nie spełni oczekiwań — zwrócimy pieniądze."}}
  ] } ]
}
{% endschema %}
