{%- comment -%} Open Graph / social share {%- endcomment -%}
{%- assign og_title = page_title | default: shop.name -%}
{%- assign og_type = 'website' -%}
{%- if request.page_type == 'product' -%}{%- assign og_type = 'product' -%}{%- endif -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ page_description | default: shop.description | default: shop.name | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
