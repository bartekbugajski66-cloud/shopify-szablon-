{%- comment -%} Stachu Strachu — Zdjęcia od klientów (poziomy pasek) {%- endcomment -%}
<section class="pf pf-cty pf-sec" id="pf-cty-{{ section.id }}">
  <div class="pf-container">
    <h2 class="pf-h2">{{ section.settings.heading }}</h2>
    <div class="pf-cty__wrap">
      <div class="pf-cty__track" id="pf-cty-track-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="pf-cty__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'pf-cty__img', alt: section.settings.heading | escape }}
            {%- else -%}<span class="pf-cty__ph"></span>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="pf-cty__arrow pf-cty__arrow--prev" data-dir="-1" aria-label="Poprzednie zdjęcia">‹</button>
        <button type="button" class="pf-cty__arrow pf-cty__arrow--next" data-dir="1" aria-label="Następne zdjęcia">›</button>
      {%- endif -%}
    </div>
  </div>
</section>
{%- style -%}
  #pf-cty-{{ section.id }} .pf-cty__wrap{position:relative;margin-top:26px}
  #pf-cty-{{ section.id }} .pf-cty__track{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:2px}
  #pf-cty-{{ section.id }} .pf-cty__track::-webkit-scrollbar{display:none}
  #pf-cty-{{ section.id }} .pf-cty__item{flex:0 0 78%;scroll-snap-align:start;border-radius:14px;overflow:hidden;background:var(--pf-bg-card)}
  #pf-cty-{{ section.id }} .pf-cty__img,#pf-cty-{{ section.id }} .pf-cty__ph{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}
  #pf-cty-{{ section.id }} .pf-cty__arrow{position:absolute;top:50%;right:8px;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:1px solid var(--pf-line);background:var(--pf-bg-card);color:var(--pf-text);font-size:18px;cursor:pointer;display:grid;place-items:center}
  #pf-cty-{{ section.id }} .pf-cty__arrow--prev{right:auto;left:8px}
  @media(min-width:640px){#pf-cty-{{ section.id }} .pf-cty__item{flex-basis:32%}}
  @media(min-width:1000px){#pf-cty-{{ section.id }} .pf-cty__item{flex-basis:23%}}
{%- endstyle -%}
<script>
(function(){
  var track=document.getElementById('pf-cty-track-{{ section.id }}');if(!track)return;
  var wrap=track.closest('.pf-cty__wrap');
  wrap.querySelectorAll('.pf-cty__arrow').forEach(function(btn){
    btn.addEventListener('click',function(){
      var item=track.querySelector('.pf-cty__item');
      var step=item?item.getBoundingClientRect().width+12:300;
      track.scrollBy({left:step*parseInt(btn.getAttribute('data-dir'),10),behavior:'smooth'});
    });
  });
})();
</script>
{% schema %}
{
  "name": "SS — Zdjęcia klientów",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Zdjęcia od klientów" }
  ],
  "blocks": [
    { "type": "photo", "name": "Zdjęcie", "settings": [
      { "type": "image_picker", "id": "image", "label": "Zdjęcie" }
    ] }
  ],
  "max_blocks": 10,
  "presets": [ { "name": "SS — Zdjęcia klientów" } ]
}
{% endschema %}
