<div class="drip-page page-width">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    {%- for article in blog.articles -%}
      <article style="border-bottom:1px solid #f1f4f9; padding:18px 0;">
        <h2 style="margin:0 0 6px; font-size:20px;"><a href="{{ article.url }}" style="color:#0F172A; text-decoration:none;">{{ article.title }}</a></h2>
        <small style="color:#64748B;">{{ article.published_at | date: '%d.%m.%Y' }}</small>
        <p style="margin:8px 0 0;">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p>
      </article>
    {%- else -%}
      <p>Brak wpisów.</p>
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}
      <nav class="drip-pagination" aria-label="Paginacja">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
