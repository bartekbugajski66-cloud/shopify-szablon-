{%- comment -%} ZAVIA — specyfikacja ze zdjęciem {%- endcomment -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    {%- render 'zv-head', s: section.settings -%}
    <div class="zv-specs{% if section.settings.image == blank %} zv-specs--noimg{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="zv-specs__img">{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 860px) 45vw, 100vw' }}</div>
      {%- endif -%}
      <dl class="zv-specs__list">
        {%- for block in section.blocks -%}
          <div class="zv-specs__row" {{ block.shopify_attributes }}><dt>{{ block.settings.key }}</dt><dd>{{ block.settings.value }}</dd></div>
        {%- endfor -%}
      </dl>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Zavia — specyfikacja",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — tęczowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" },
      { "value": "mint", "label": "Miętowe" }, { "value": "sky", "label": "Błękitne" }, { "value": "sun", "label": "Słoneczne" }, { "value": "none", "label": "Brak" } ]},
    { "type": "image_picker", "id": "image", "label": "Zdjęcie produktu" }
  ],
  "blocks": [
    { "type": "spec", "name": "Wiersz", "settings": [
      { "type": "text", "id": "key", "label": "Cecha", "default": "Cecha" },
      { "type": "text", "id": "value", "label": "Wartość", "default": "Wartość" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Zavia — specyfikacja" }]
}
{% endschema %}
