{%- comment -%} ZAVIA — co w zestawie {%- endcomment -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    {%- render 'zv-head', s: section.settings -%}
    <div class="zv-box">
      {%- for block in section.blocks -%}
        <div class="zv-box__item" {{ block.shopify_attributes }}>
          <div class="zv-box__ico" aria-hidden="true">{{ block.settings.icon }}</div>
          <div>
            <h3>{{ block.settings.title }}{% if block.settings.tag != blank %}<span class="zv-box__tag">{{ block.settings.tag }}</span>{% endif %}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Zavia — co w zestawie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — tęczowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" },
      { "value": "mint", "label": "Miętowe" }, { "value": "sky", "label": "Błękitne" }, { "value": "sun", "label": "Słoneczne" }, { "value": "none", "label": "Brak" } ]}
  ],
  "blocks": [
    { "type": "item", "name": "Element", "settings": [
      { "type": "text", "id": "icon", "label": "Emotka", "default": "📦" },
      { "type": "text", "id": "title", "label": "Nazwa", "default": "Element" },
      { "type": "text", "id": "tag", "label": "Plakietka" },
      { "type": "textarea", "id": "text", "label": "Opis" }
    ]}
  ],
  "presets": [{ "name": "Zavia — co w zestawie" }]
}
{% endschema %}
