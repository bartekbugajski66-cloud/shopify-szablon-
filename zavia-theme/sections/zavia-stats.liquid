{%- comment -%} ZAVIA — liczniki (wpisuj tylko prawdziwe liczby) {%- endcomment -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    {%- render 'zv-head', s: section.settings -%}
    <div class="zv-stats">
      {%- for block in section.blocks -%}
        <div class="zv-stat" {{ block.shopify_attributes }}>
          <b class="zv-rainbow-text">{{ block.settings.number }}</b>
          <span>{{ block.settings.label }}</span>
          {%- if block.settings.note != blank -%}<small>{{ block.settings.note }}</small>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Zavia — liczniki",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — tęczowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" },
      { "value": "mint", "label": "Miętowe" }, { "value": "sky", "label": "Błękitne" }, { "value": "sun", "label": "Słoneczne" }, { "value": "none", "label": "Brak" } ]}
  ],
  "blocks": [
    { "type": "stat", "name": "Licznik", "settings": [
      { "type": "text", "id": "number", "label": "Liczba", "default": "30", "info": "Wpisuj prawdziwe dane (np. liczbę zamówień z panelu Shopify)." },
      { "type": "text", "id": "label", "label": "Opis", "default": "dni gwarancji" },
      { "type": "text", "id": "note", "label": "Przypis" }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Zavia — liczniki", "blocks": [{ "type": "stat" }] }]
}
{% endschema %}
