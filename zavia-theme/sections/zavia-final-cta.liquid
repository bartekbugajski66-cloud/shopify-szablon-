{%- comment -%} ZAVIA — końcowe wezwanie do zakupu {%- endcomment -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    <div class="zv-final">
      <span class="zv-final__floaty" style="top:16px;left:18px" aria-hidden="true">🌈</span>
      <span class="zv-final__floaty" style="top:24px;right:22px;animation-delay:.6s" aria-hidden="true">🦄</span>
      <span class="zv-final__floaty" style="bottom:18px;left:12%;animation-delay:1.2s;font-size:30px" aria-hidden="true">💅</span>
      <span class="zv-final__floaty" style="bottom:22px;right:10%;animation-delay:.3s;font-size:30px" aria-hidden="true">✨</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
      <a href="#kup" class="zv-btn">{{ section.settings.cta }}</a>
      {%- assign chips = section.settings.chips | split: ',' -%}
      <div class="zv-final__chips">{%- for c in chips -%}<span>{{ c | strip }}</span>{%- endfor -%}</div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Zavia — końcowe CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Tytuł", "default": "Podaruj jej odrobinę magii ✨" },
    { "type": "textarea", "id": "subheading", "label": "Tekst", "default": "Uśmiech dziecka, gdy pierwszy raz zobaczy wzorek na swoim paznokciu — bezcenny. Zamów Zavię dziś." },
    { "type": "text", "id": "cta", "label": "Przycisk", "default": "Wybieram zestaw 💖" },
    { "type": "text", "id": "chips", "label": "Plakietki (po przecinku)", "default": "🚀 Szybka wysyłka, 🛡️ 30 dni gwarancji, 🔒 Bezpieczne płatności" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" }, { "value": "none", "label": "Brak" } ]}
  ],
  "presets": [{ "name": "Zavia — końcowe CTA" }]
}
{% endschema %}
