{%- comment -%} ZAVIA — jak to działa (3 kroki) {%- endcomment -%}
<section class="zv-sec zv-sec--{{ section.settings.bg }}">
  <div class="zv-container">
    {%- render 'zv-head', s: section.settings -%}
    <div class="zv-steps">
      {%- for block in section.blocks -%}
        <div class="zv-step" {{ block.shopify_attributes }}>
          <span class="zv-step__num">{{ forloop.index }}</span>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: class: 'zv-step__img', loading: 'lazy', sizes: '(min-width: 800px) 33vw, 100vw' }}
          {%- else -%}
            <div class="zv-step__ico" aria-hidden="true">{{ block.settings.icon }}</div>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Zavia — jak to działa",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł" },
    { "type": "text", "id": "heading", "label": "Tytuł" },
    { "type": "text", "id": "heading_accent", "label": "Tytuł — tęczowa część" },
    { "type": "textarea", "id": "subheading", "label": "Podtytuł" },
    { "type": "select", "id": "bg", "label": "Tło", "default": "white", "options": [
      { "value": "white", "label": "Białe" }, { "value": "pink", "label": "Różowe" }, { "value": "lilac", "label": "Liliowe" },
      { "value": "mint", "label": "Miętowe" }, { "value": "sky", "label": "Błękitne" }, { "value": "sun", "label": "Słoneczne" }, { "value": "none", "label": "Brak" } ]}
  ],
  "blocks": [
    { "type": "step", "name": "Krok", "settings": [
      { "type": "image_picker", "id": "image", "label": "Zdjęcie (opcjonalnie)" },
      { "type": "text", "id": "icon", "label": "Emotka (gdy brak zdjęcia)", "default": "💅" },
      { "type": "text", "id": "title", "label": "Tytuł", "default": "Krok" },
      { "type": "textarea", "id": "text", "label": "Tekst" }
    ]}
  ],
  "presets": [{ "name": "Zavia — jak to działa" }]
}
{% endschema %}
